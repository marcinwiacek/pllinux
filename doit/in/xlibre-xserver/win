#!/bin/sh
#DPI="-dpi 140"
DPI=""
PS1ORIG=$(printenv PS1ORIG)
if [ "$PS1ORIG" = "" ]; then PS1ORIG=$(printenv PS1); fi
if [ -d /log ]; then
  PS1="$PS1ORIG" strace /app/xinit/current/bin/startx -- vt11 $DPI -logfile /log/tmp/x 2> /tmp/2 > /tmp/1
else
  PS1="$PS1ORIG" strace /app/xinit/current/bin/startx -- $DPI vt11 2> /tmp/2 > /tmp/1
fi

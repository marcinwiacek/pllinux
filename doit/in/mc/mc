#!/app/busybox/current/bin/sh
DIR=$(dirname $0)
APP=""
if [ -d "/home/root" ]; then
  # root
  APP="$APP --bind /app app --bind /etc etc "
  MCHOME=/home/root/app/mc
else
  # non root
  APP="$APP --ro-bind /app app --ro-bind /etc/localtime etc/localtime "
  MCHOME=/home/app/mc
fi
if [ ! -d "/iso" ]; then
  # normal system, not iso
  APP="$APP --chdir $(pwd) ";
fi
for DEV in $(ls /dev); do
  case $DEV in
  nvme*|fb0|log|mapper|dri)
    APP="$APP --dev-bind-try /dev/$DEV /dev/$DEV"
  esac
done
mkdir $MCHOME 2> /dev/null

PS111="[\t] $USER # "
#doesnt work because it's started always in /
#PS111="$USER : reparse $(pwd) $(/app/git/current/git branch --show-current) po $(if [ -f "/app/git/current/bin/git" ] && /app/git/current/git rev-parse --git-dir > /dev/null 2>&1; then echo -n \" \e[33m\";/app/git/current/git branch --show-current; fi) # "

/app/bwrap/current/bin/bwrap \
    --setenv HOME $MCHOME \
    --dev dev \
    --dev-bind-try /dev/pts/ptmx /dev/pst/ptmx \
    --proc proc \
    --bind /tmp tmp \
    --bind /home home \
    --bind-try /run run \
    --bind-try /mnt mnt \
    --bind-try /sys sys \
    --bind-try /log log \
    --bind-try /usr usr \
    --ro-bind $DIR/bin bin \
    --ro-bind /lib64 lib64 \
    --setenv TERM linux \
    --setenv PS1 "$PS111" \
    $APP \
    $DIR/bin/mc

    # devices are mapped, but... problem with shell prompt (we map too much and some device is making mess)
    #--dev-bind /dev /dev \

    # no clean before running command in options
    #    --setenv SHELL /app/busybox/current/bin/sh \

    # in BASH don't show internal commands from MC in the shell history
    #    --setenv HISTCONTROL ignorespace \

    # -u will disable subshell

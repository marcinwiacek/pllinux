#!/app/busybox/current/bin/sh
DIR=$(dirname $0)
APP=""
if [ ! -d "/iso" ]; then
  # normal system, not iso
  APP="$APP --chdir $(pwd) ";
fi
if [ -d "/home/root" ]; then
  # root
  APP="$APP --bind /app app --bind /etc etc "
  MCHOME=/home/root/app
  PS111="\e[31m[\t] $USER # \e[m"
else
  # non root
  APP="$APP --ro-bind /app app --ro-bind /etc/localtime etc/localtime "
  MCHOME=/home/app
  PS111="\e[32m[\t] $USER # \e[m"
fi
/app/busybox/current/bin/mkdir $MCHOME 2> /dev/null

#doesnt work because it's started always in /
#PS111="$USER : reparse $(pwd) $(/app/git/current/git branch --show-current) po $(if [ -f "/app/git/current/bin/git" ] && /app/git/current/git rev-parse --git-dir > /dev/null 2>&1; then echo -n \" \e[33m\";/app/git/current/git branch --show-current; fi) # "

#--bind / /  makes problem - everything created in bin is visible outside
#important device - /dev/pts/ptmx

/app/bwrap/current/bin/bwrap \
    --setenv HOME $MCHOME \
    --bind / / \
    --tmpfs bin \
    --symlink /app/busybox/current/bin/sh /bin/sh \
    --dev-bind /dev /dev \
    --proc proc \
    --bind /tmp tmp \
    --bind /home home \
    --bind-try /run run \
    --bind-try /mnt mnt \
    --bind-try /sys sys \
    --bind-try /log log \
    --bind-try /usr usr \
    --ro-bind /lib64 lib64 \
    --setenv PS1 "$PS111" \
    --setenv PS1ORIG "$(printenv PS1)" \
    $APP -- \
    $DIR/bin/mc
#    strace $DIR/bin/mc 2> /tmp/tmpdebug

        done
        cmd=$(dialog --stdout --backtitle "PLLinux/set users/set user $1/keyboard and font/set keyboard" --cancel-label "Back" \
           --menu "Select keyboard" 0 0 10 $list)
         listnr=1
        for NAME in $(ls /app/kbd/current/share/keymaps/i386/qwerty); do
                if [ $listnr = $cmd ]; then
                  USER_KEYB="qwerty/$NAME"
                fi
              listnr=$(($listnr+1))
        done
        for NAME in $(ls /app/kbd/current/share/keymaps/i386/qwertz); do

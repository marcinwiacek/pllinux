  case $ETH_STATUS in
    *UP*) ETH_ENABLED="up" ;;
    *) ETH_ENABLED="down" ;;
  esac

  get_value_from_conf_file "ETH_START" "0"
  ETH_START="start manually"
  if [ "$CONF_FILE_VALUE" = 1 ]; then ETH_START="on system start"; fi

  get_value_from_conf_file "ETH_IP4" ""
  ETH_IP4="IP4 $CONF_FILE_VALUE"
  if [ "$CONF_FILE_VALUE" = "" ]; then ETH_IP4="IP4 DHCP"; fi

  cmd=$(dialog --stdout --backtitle "PLLinux" --cancel-label "Quit" \
       --default-item $mainmenunum \
       --menu "Welcome to the PLLinux configuration (version from $VER)" 0 0 24 \
       1 "Apps (app)" \
       2 "Background tasks after changing files or dirs (inotifyd)" \
       3 "Background tasks running in specified time for all users (crond)" \
       4 "Background services (dinit)" \
       5 "Devices (info, power options, partitioning, etc.)" \
       6 "Disk usage" \
       7 "Network firewall (nftables)" \
       8 "Task manager (top, q to quit)" \
       9 "Time" \
       10 "Kernel modules (modprobe, modinfo)" \
       11 "Kernel params (sysctl)" \
       12 "Kernel logs (dmesg, can be saved with syslogd, q to quit)" \
       14 "System logs saved in files (syslogd)" \
       15 "Users (adduser, etc.)" \
       16 "User groups" \
       17 "App language (todo)           - $LANG" \
       18 "Keyboard and font (kbd)       - $KEYB, $FONT" \
       19 "Network (ip)                  - $ETH_ENABLED, $ETH_START, $ETH_IP4" \
       20 "Swap file (swapon,off,mkswap) - $SWAP_ON_OFF" \
       21 "Timezone                      - $TIMEZONE" \
       22 "Partition encryption password (todo)" \
       23 "Install or clone PLLinux to other partition" \
       24 "Setup UEFI boot menu (todo)" \
       25 "Setup UEFI fat32 boot partition (todo)" )
  if [ $? == 0 ]; then
    mainmenunum="$cmd"
    case $cmd in
    1) set_system_apps ;;
    3) tasks "crontab" ;;
    4) services ;;
    5) devices ;;
    6) HOMEINFO="App - $(cd ${DIR}app && du -c -h | grep total) \n"
       DIRLIST="$(ls ${DIR}home)"
       while read -r line; do
         HOMEINFO="${HOMEINFO}User $line - $(cd ${DIR}home/$line && du -c -h | grep total) \n"
       done <<< $DIRLIST
       dialog --backtitle "PLLinux\device manager\disk usage \(du, df\)" --msgbox "$HOMEINFO" 100 90 ;;
    8) top ;;
    10) kernel_modules ;;
    11) kernel_param ;;
    12) dmesg | less ;; # it seems, that msgbox and other dialog elements have size limit
    14) logs ;;
    15) set_users ;;
    18) NEW_KEYB="$KEYB"
        NEW_FONT="$FONT"
        set_keyboard_font_general_or_user "" ;;
    19) network ;;
    20) swap_file ;;
    21) set_time_zone ;;
    23) install_to 1 ;;
    24) dialog --backtitle "PLLinux\setup UEFI boot menu" --msgbox "$(efibootmgr)" 100 90 ;;
    esac
  else
    break
  fi
done

clear
set_general_config 0

# Part of PLLINUX. Version from 28 July 2026. Creating system cfg from cfg file or asking user and creating cfg file.

CFGFILE="/etc/pllinux.cfg"
if [ "$1" != "" ]; then
  CFGFILE="$1"
fi
if [ -e "$CFGFILE" ]; then
  while read -r line; do
    IFS="=" read -r PARAM_NAME PARAM_VALUE << EOF
$line
EOF
    case $PARAM_NAME in
    *KEYB* )
      /app/kbd/current/bin/loadkeys /app/kbd/current/share/keymaps/i386/$PARAM_VALUE
      ;;
    *FONT* )
      /app/kbd/current/bin/setfont -C /dev/tty1 $PARAM_VALUE 2> /dev/null
      /app/kbd/current/bin/setfont -C /dev/tty2 $PARAM_VALUE 2> /dev/null
      /app/kbd/current/bin/setfont -C /dev/tty3 $PARAM_VALUE 2> /dev/null
      /app/kbd/current/bin/setfont -C /dev/tty4 $PARAM_VALUE 2> /dev/null
      ;;
    *TIMEZONE* )
      CURRENT=$(realpath /etc/localtime)
      # save SSD writes
      if [ "$CURRENT" != "/app/tzdb/current/usr/share/zoneinfo/$PARAM_VALUE" ]; then
        echo Setting timezone
        ln -s /app/tzdb/current/usr/share/zoneinfo/$PARAM_VALUE /etc/localtime
      else
        echo Skipping setting timezone
      fi
      ;;
    *LANG* )
      export LANG=$PARAM_VALUE
      ;;
    esac
  done < $CFGFILE
fi
if [ "$1" != "" ]; then
  exit
fi

OPT="def"
while true; do
  echo "Step 1/3 - keyboard and screen font"
  if [ "$OPT" = "def" ]; then
    echo "  What national characters do you want to see or write? (pls provide two characters ISO code like us, pl, etc.)"
    read lang
    KEYB="qwerty/pl4.map.gz"
    FONT="sun12x22.psfu.gz"
    if [ $lang = "pl" ]; then
      KEYB="qwerty/pl1.map.gz"
      FONT="LatGrkCyr-8x16.psfu.gz"
    fi
  fi
  echo "  Selected keyboard $KEYB, screen font $FONT"
  /app/kbd/current/bin/setfont -C /dev/tty1 $FONT
  /app/kbd/current/bin/loadkeys /app/kbd/current/share/keymaps/i386/$KEYB
  echo "  Write some text to check or \"quit\" (no saving) or \"keyb\" (set keyboard) or \"font\" (set font) or \"save\" (save & go further) or \"def\" (set default)"
  read OPT
  case $OPT in
    keyb)
      ls /app/kbd/current/share/keymaps/i386/qwerty
      ls /app/kbd/current/share/keymaps/i386/azerty
      ls /app/kbd/current/share/keymaps/i386/qwertz
      echo "  Write one of displayed keyboard names"
      read x
      if [ "$x" = "" ]; then
        echo "Value cannot be empty"
      elif [ -e "/app/kbd/current/share/keymaps/i386/qwerty/$x" ]; then
        KEYB="qwerty/$x"
      elif [ -e "/app/kbd/current/share/keymaps/i386/azerty/$x" ]; then
        KEYB="azerty/$x"
      elif [ -e "/app/kbd/current/share/keymaps/i386/qwertz/$x" ]; then
        KEYB="qwertz/$x"
      else
        echo Keyboard file \"$x\" not found. Ignoring.
      fi
      ;;
    font)
      ls /app/kbd/current/share/consolefonts
      echo "  Write one of displayed fonts"
      read x
      if [ "$x" = "" ]; then
        echo "Value cannot be empty"
      elif [ -e "/app/kbd/current/share/consolefonts/$x" ]; then
        FONT="$x"
      else
        echo Screen font file \"$x\" not found. Ignoring.
      fi
      ;;
    quit)
      return
      ;;
    save)
      break;
      ;;
  esac
done
echo "KEYB=$KEYB" > /etc/pllinux.cfg
echo "FONT=$FONT" >> /etc/pllinux.cfg

TIMEZONE="UTC";
while true; do
  echo "Step 2/3 - timezone"
  echo "  Selected timezone $TIMEZONE";
  ls /app/tzdb/current/usr/share/zoneinfo
  echo "  Please enter region or timezone name or \"quit\" (no saving) or \"save\" (save & go further)"
  read tz
  case $tz in
    quit)
      return
      ;;
    save)
      break;
      ;;
    *)     
      if [ -e "/app/tzdb/current/usr/share/zoneinfo/$tz" ]; then
        TIMEZONE=$tz
      elif [ -d "/app/tzdb/current/usr/share/zoneinfo/$tz" ]; then
        ls /app/tzdb/current/usr/share/zoneinfo/$tz
        echo "  Please enter timezone name or \"quit\" (no saving) or \"save\" (save & go further)"
        read tz2
        case $tz2 in
          quit)
            return
            ;;
          save)
            break;
            ;;
          *)     
            if [ -e "/app/tzdb/current/usr/share/zoneinfo/$tz/$tz2" ]; then
              TIMEZONE=$tz/$tz2
            else
              echo "  Timezone file \"$tz/$tz2\" not found. Ignoring"
            fi  
            ;;
        esac
      ;;
  esac
done
echo "TIMEZONE=$TIMEZONE" >> /etc/pllinux.cfg


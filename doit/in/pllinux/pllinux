              ;;
          esac
        done
        cmd=$(dialog --stdout --backtitle "PLLinux/set users/set user $1/keyboard and font/set font" --cancel-label "Back" \
           --menu "Select font" 0 0 10 $list)
        if [ $? == 0 ]; then
          listnr=1
          for NAME in $(ls /app/kbd/current/share/consolefonts); do
            case $NAME in
              README*)
                ;;
              *)
                if [ $listnr = $cmd ]; then
                  USER_FONT="$NAME"
                fi
                listnr=$(($listnr+1))
                ;;
            esac
          done
        fi
        ;;
      4)
         list=""
         listnr=1
        for NAME in $(ls /app/kbd/current/share/keymaps/i386/qwerty); do
              list="$list $listnr qwerty/$NAME"
              listnr=$(($listnr+1))
        done
        for NAME in $(ls /app/kbd/current/share/keymaps/i386/qwertz); do
              list="$list $listnr qwertz/$NAME"
              listnr=$(($listnr+1))
        done
        for NAME in $(ls /app/kbd/current/share/keymaps/i386/azerty); do

swap_file() {
    get_value_from_conf_file "SWAP_SIZE" "0"
    SWAP_SIZE="$CONF_FILE_VALUE"
    get_value_from_conf_file "SWAP_AGGRESIVE" "10"
    SWAP_AGGRESIVE="$CONF_FILE_VALUE"
    get_value_from_conf_file "SWAP_ZSWAP" "1"
    SWAP_ZSWAP="$CONF_FILE_VALUE"
    cmd=$(dialog --stdout --backtitle "PLLinux\\swap file" --cancel-label "Back" \
      --form "Swap file is increasing disk usage and is slow, but can increase RAM size available for system" 0 0 8 \
      "Size in MB (0 disables it)" 1 1 "$SWAP_SIZE" 1 50 10 0 \
      "How aggressive is moving to swap (0-100)" 2 1 "$SWAP_AGGRESIVE" 2 50 10 0 \
      "Using zswap (compress RAM before saving to swap)" 3 1 "$SWAP_ZSWAP" 3 50 10 0 )
    if [ $? == 0 ]; then
        linenr=1
        while read -r line; do
          case $linenr in
          1) if [ "$line" = "0" ]; then
               swapoff /swapfile
               rm /swapfile
             else
               swapoff /swapfile || true
               rm /swapfile || true
               fallocate -l ${line}M /swapfile
               chmod 600 /swapfile
               mkswap /swapfile
               swapon /swapfile
             fi 
             change_value_in_conf_file "SWAP_SIZE" "$line" ;;
          2) /app/busybox/current/bin/sysctl vm.swappiness=$line 
             change_value_in_conf_file "SWAP_AGGRESIVE" "$line" ;;
          esac
          linenr=$(($linenr+1))
        done <<< "$cmd"
    fi
}

network_change_config_file() {
  linenum=0
  if [ "$1" = "" ]; then
    if [ -f ${DIR}etc/network/interfaces ]; then
      file_content=$(cat ${DIR}etc/network/interfaces)
      while read -r line; do
        if [ "$line" = "auto eth0" ]; then linenum=$(($linenum+1)); fi
        if [ "$line" = "iface eth0 inet dhcp" ]; then linenum=$(($linenum+1)); fi
      done <<< "$file_content"
    fi
    if [ "$linenum" != 2 ]; then
      echo "#created by script pllinux" > ${DIR}etc/network/interfaces
      echo "auto eth0" >> ${DIR}etc/network/interfaces
      echo "iface eth0 inet dhcp" >> ${DIR}etc/network/interfaces
    fi
  else
    if [ -f ${DIR}etc/network/interfaces ]; then
      file_content=$(/app/busybox/current/bin/cat ${DIR}etc/network/interfaces)
      while read -r line; do
        if [ "$line" = "iface eth0 inet static" ]; then linenum=$(($linenum+1)); fi
        if [ "$line" = "address $1" ]; then linenum=$(($linenum+1)); fi
        if [ "$line" = "netmask $2" ]; then linenum=$(($linenum+1)); fi
        if [ "$line" = "gateway $3" ]; then linenum=$(($linenum+1)); fi
      done <<< "$file_content"
    fi
    if [ "$linenum" != 4 ]; then
      echo "#created by script pllinux" > ${DIR}etc/network/interfaces
      echo "iface eth0 inet static" >> ${DIR}etc/network/interfaces
      echo "address $1" >> ${DIR}etc/network/interfaces
      echo "netmask $2" >> ${DIR}etc/network/interfaces
      echo "gateway $3" >> ${DIR}etc/network/interfaces
    fi
  fi
}


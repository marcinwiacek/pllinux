log_entry() {
  INPUT1="$1"
  INPUT2="$2"
  while true; do
    PROMPT="PLLinux\\logs"
    abc=$(echo dialog --stdout --backtitle \"$PROMPT\" --cancel-label "Back" \
           --default-item $listnr3 \
       --menu \"Logs saved to files \(temporary or permanent\)\" 0 0 8 \
       $(log_entry_list $INPUT1 $INPUT2) )
    cmd=$(eval $abc)
    if [ $? == 0 ]; then
      listnr=1
      IFS=" "
    while read -r entry; do
      listnr=$(($listnr+1))
    done <<< "$INPUT1"
      IFS=$IFSORIG
      case $cmd in
      1 )  #search
        cat $INPUT2 | less # it seems, that msgbox and other dialog elements have size limit
        ;;
      2 )  #save and back
        break
        ;;
      $listnr) # file
        LOG_FILE="$INPUT2"
        log_file ;;
      $(($listnr+3)) )  #clear
        ;;
      $(($listnr+4)) )  #delete rule
        ;;
      $(($listnr+5)) )  #delete all
        ;;
      *) # edit rule
        listnr3=1
        IFS=" "
        while read -r entry; do
          if [ "$cmd" = "$listnr3" ]; then
             break;
          fi
          listnr3=$(($listnr3+1))
        done <<< "$INPUT1"
        IFS=$IFSORIG
        IFS="." read -r LOG_TYPE LOG_PRIORITY << EOF
$line
EOF
        TASKSTEPNR=1
        while true; do
          case $TASKSTEPNR in
          0) break; ;;
          1) log_feature_type ;;
          2) log_feature_priority ;;
          3) 
             NEWFEAT=""
             listnr=1
             IFS=" "
             while read -r entry; do
               if [ "$listnr3" = "$listnr" ]; then
                  NEWFEAT="$NEWFEAT,${LOG_TYPE}.${LOG_PRIORITY}"
               else
                  NEWFEAT="$NEWFEAT,$entry"
               fi
               listnr=$(($listnr+1))
             done <<< "$INPUT1"
             $INPUT1=${NEWFEAT}
             IFS=$IFSORIG

#echo "${LOG_TYPE}.${LOG_PRIORITY} ${LOG_FILE} " >> ${DIR}etc/syslog.conf
# fixme reload service
             break;;
          esac
        done
        ;;
      esac
    else
      break;
    fi
  done
}


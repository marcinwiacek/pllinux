#!/app/busybox/current/bin/sh
# Part of PLLINUX. Version from 9 Aug 2026. Creating system cfg from conf file or asking user and creating conf file.

DIR="/" # path with / in the end. In real system /
if [ -d "/mnt/x" ]; then
  DIR="/mnt/x/"
fi

IFSORIG=$IFS

SYSTEM_APPS="dialog:gcc:glib:glibc:gptfdisk:groff:ncurses:ncursesw:rsync:wget2:parted:busybox:bwrap:dinit:e2fsprogs:initramfs:kbd:kernel:ldso:libc:libtinfo:nftables:pllinux:util-linux" # we cannot remove "current" version for these apps

# some default values
TIMEZONE="UTC"
KEYB="qwerty/pl4.map.gz"
FONT="sun12x22.psfu.gz"
LANG="en_US.UTF-8"

FIRST_SAVE=1

change_value_in_conf_file() {
  if [ "$FIRST_SAVE" = "1" ]; then
     cp ${DIR}$CFGFILE ${DIR}${CFGFILE}-
     FIRST_SAVE=0
  fi
  file_content=$(cat ${DIR}$CFGFILE)
  echo "# Created by script pllinux version from 2 Aug 2026" > ${DIR}$CFGFILE
  while IFS= read -r line; do
    IFS="=" read -r PARAM_NAME PARAM_VALUE << EOF
$line
EOF
    if [ "$PARAM_NAME" != "$1" ] && [ ${line:0:1} != "#" ]; then
      echo "$line" >> ${DIR}$CFGFILE
    fi
  done <<< "$file_content"
  echo "$1=$2" >> ${DIR}$CFGFILE
  IFS=$IFSORIG
}

get_value_from_conf_file() {
  CONF_FILE_VALUE=""
  while read -r line; do
    IFS="=" read -r PARAM_NAME PARAM_VALUE << EOF
$line
EOF
    case $PARAM_NAME in
    $1* )
      CONF_FILE_VALUE=$PARAM_VALUE
      ;;
    esac
  done < $DIR$CFGFILE
  IFS=$IFSORIG
}

set_general_config() {
  if [ -e "$DIR$CFGFILE" ]; then
    while read -r line; do
      IFS="=" read -r PARAM_NAME PARAM_VALUE << EOF
$line
EOF
      case $PARAM_NAME in
      KEYB* )
        if [ "$1" = "1" ]; then
           /app/kbd/current/bin/loadkeys /app/kbd/current/share/keymaps/i386/$PARAM_VALUE
        fi
        KEYB="$PARAM_VALUE" ;;
      FONT* )
        if [ "$1" = "1" ]; then
          for DEVDEV in 1 2 3 4; do
            /app/kbd/current/bin/setfont -C /dev/tty$DEVDEV $PARAM_VALUE 2> /dev/null
          done
        fi
        FONT="$PARAM_VALUE" ;;
      TIMEZONE* )
        CURRENT=$(/app/busybox/current/bin/realpath /etc/localtime)
        case $CURRENT in
          *$PARAM_VALUE*)
            # save SSD writes. Don't make link when it's there.
            ;;
          *)
            echo Setting timezone $PARAM_VALUE
            rm /etc/localtime
            ln -s /app/tzdb/current/usr/share/zoneinfo/$PARAM_VALUE /etc/localtime
        esac
        TIMEZONE=$PARAM_VALUE ;;
      LANG* )
        list=$(/app/glibc/current/bin/locale -a)
        case $list in
          *$PARAM_VALUE*)
            ;;
          *)
            echo Generating locale
            mkdir /app/glibc/current/lib/locale
            #localedef -i pl_PL -c -f UTF-8 pl_PL.UTF-8
            localedef -i en_US -c -f UTF-8 en_US.UTF-8 ;;
        esac
        LANG=$PARAM_VALUE ;;
      esac
    done < $DIR$CFGFILE
  fi
}

set_keyboard_font_general_or_user() {
  if [ "$1" = "" ]; then
    PROMPT="PLLinux";
    PROMPT2="";
  else
    PROMPT="PLLinux\set users\\$1";
    PROMPT2=" for $1";
  fi
  while true; do
    /app/kbd/current/bin/setfont -C /dev/tty1 $NEW_FONT
    /app/kbd/current/bin/loadkeys /app/kbd/current/share/keymaps/i386/$NEW_KEYB
    cmd=$(dialog --stdout --backtitle "$PROMPT\keyboard and font" --cancel-label "Back" \
           --menu "Set display and typing$PROMPT2" 0 0 5 \
           1 "Check" \
           2 "Set default" \
           3 "Set font     - $NEW_FONT" \
           4 "Set keyboard - $NEW_KEYB" \
           5 "Save and back")
    if [ $? == 0 ]; then
      case $cmd in
      1) $(dialog --stdout --backtitle "$PROMPT\keyboard and font\check" --cancel-label "Back" \
                --inputbox "Please test your keyboard layout" 15 30) ;;
      2) cmd=$(dialog --stdout --backtitle "$PROMPT\keyboard and font\set default" --cancel-label "Back" \
           --menu "Set proposed option for concrete language" 0 0 5 \
             1 "PL" 2 "Other")
           if [ $? == 0 ]; then
             NEW_KEYB="qwerty/pl4.map.gz"
             NEW_FONT="sun12x22.psfu.gz"
             case $cmd in
               1) NEW_KEYB="qwerty/pl1.map.gz"
                  NEW_FONT="LatGrkCyr-8x16.psfu.gz" ;;
             esac
           fi
           ;;
      3) list=""
         listnr=1
         for NAME in $(ls /app/kbd/current/share/consolefonts); do
           case $NAME in
             README*)
                ;;
             *) list="$list $listnr $NAME"
                if [ "$NEW_FONT" == "$NAME" ]; then
                  DEFAULT_NUM=$listnr
                fi
                listnr=$(($listnr+1))
                ;;
           esac
         done
         cmd=$(dialog --stdout --backtitle "$PROMPT\keyboard and font\set font" --cancel-label "Back" \
           --default-item $DEFAULT_NUM \
           --menu "Select font" 0 0 10 $list)
         if [ $? == 0 ]; then
           listnr=1
           for NAME in $(ls /app/kbd/current/share/consolefonts); do
             case $NAME in
               README*)
                  ;;
               *) if [ $listnr = $cmd ]; then
                    NEW_FONT="$NAME"
                  fi
                  listnr=$(($listnr+1))
                  ;;
             esac
           done
         fi
         ;;
      4) list=""
         listnr=1
         for DIRDIR in qwerty qwertz azerty; do
           for NAME in $(ls /app/kbd/current/share/keymaps/i386/$DIRDIR); do
             list="$list $listnr $DIRDIR/$NAME"
             if [ "$NEW_KEYB" == "$DIRDIR/$NAME" ]; then
               DEFAULT_NUM=$listnr
             fi
             listnr=$(($listnr+1))
           done
         done
         cmd=$(dialog --stdout --backtitle "$PROMPT\keyboard and font\set keyboard" --cancel-label "Back" \
                 --default-item $DEFAULT_NUM \
                 --menu "Select keyboard" 0 0 10 $list)
         listnr=1
         for DIRDIR in qwerty qwertz azerty; do
           for NAME in $(ls /app/kbd/current/share/keymaps/i386/$DIRDIR); do
             if [ $listnr = $cmd ]; then
               NEW_KEYB="$DIRDIR/$NAME"
             fi
             listnr=$(($listnr+1))
           done
         done
         ;;
      5) if [ "$1" = "" ]; then
           change_value_in_conf_file "FONT" "$NEW_FONT"
           change_value_in_conf_file "KEYB" "$NEW_KEYB"
           FONT=$NEW_FONT
           KEYB=$NEW_KEYB
         else
           change_value_in_conf_file "$1_FONT" "$NEW_FONT"
           change_value_in_conf_file "$1_KEYB" "$NEW_KEYB"
         fi
         break;
         ;;
      esac
    else
      break;
    fi
  done
  /app/kbd/current/bin/setfont -C /dev/tty1 $FONT
  /app/kbd/current/bin/loadkeys /app/kbd/current/share/keymaps/i386/$KEYB
}

set_time_zone() {
  list=""
  listnr=1
  for NAME in $(ls /app/tzdb/current/usr/share/zoneinfo); do
    if [ -d "/app/tzdb/current/usr/share/zoneinfo/$NAME" ]; then
      for NAME2 in $(ls /app/tzdb/current/usr/share/zoneinfo/$NAME); do
        list="$list $listnr $NAME/$NAME2"
        if [ "$TIMEZONE" == "$NAME/$NAME2" ]; then
          DEFAULT_NUM=$listnr
        fi
        listnr=$(($listnr+1))
      done
    else
      list="$list $listnr $NAME"
      if [ "$TIMEZONE" == "$NAME" ]; then
        DEFAULT_NUM=$listnr
      fi
      listnr=$(($listnr+1))
    fi
  done
  cmd=$(dialog --stdout --backtitle "PLLinux\set timezone" --cancel-label "Back" \
           --default-item $DEFAULT_NUM \
           --menu "Selected timezone $TIMEZONE. Please select new value" 0 0 10 $list)
  if [ $? = 0 ]; then
    listnr=1
    for NAME in $(ls /app/tzdb/current/usr/share/zoneinfo); do
      if [ -d "/app/tzdb/current/usr/share/zoneinfo/$NAME" ]; then
        for NAME2 in $(ls /app/tzdb/current/usr/share/zoneinfo/$NAME); do
          if [ $listnr = $cmd ]; then
            TIMEZONE=$NAME/$NAME2
            change_value_in_conf_file "TIMEZONE" "$TIMEZONE"
          fi
          listnr=$(($listnr+1))
        done
      else
        if [ $listnr = $cmd ]; then
          TIMEZONE=$NAME
          change_value_in_conf_file "TIMEZONE" "$TIMEZONE"
        fi
        listnr=$(($listnr+1))
      fi
    done
  fi
}

add_new_user() {
  cmd=$(dialog --stdout --backtitle "PLLinux\set users\add new user" --cancel-label "Back" \
           --menu "Add new user" 0 0 10 1 "x")
}

find_app_description() {
  fl=1
  if [ -e "$1/readme.md" ]; then
     sectionDescription=0
     while read -r line; do
       if [ "$line" = "**Description**" ]; then
         sectionDescription=1
       elif [ "$line" = "" ]; then
         sectionDescription=0;
       elif [ "$sectionDescription" = 1 ]; then
         if [ "$APP_DESC" == "" ]; then
           if [ "$fl" = "1" ]; then
             case $line in
             *\"*) ;;
             *)
               echo \"$line\"
               ;;
             esac
             fl=0
           fi
         fi
       fi
     done < $1/readme.md
  fi
  if [ "$fl" = "1" ]; then
    echo \"\"
  fi
}

all_apps() {
  listnr=1
  for APP_NAME in $(ls ${DIR}app); do
    for APP_VERSION in $(ls ${DIR}app/${APP_NAME}); do
      if [ "$APP_VERSION" == "current" ]; then
        echo  "$listnr "
        echo  "${APP_NAME}:${APP_VERSION} "
        case $USER_APPS in
        *${APP_NAME}\ ${APP_VERSION}*)
          echo  "on "
          echo  $(find_app_description ${DIR}app/${APP_NAME}/${APP_VERSION})
          ;;
        *)
          echo  "off "
          echo  $(find_app_description ${DIR}app/${APP_NAME}/${APP_VERSION})
          ;;
        esac
        listnr=$(($listnr+1))
      fi
    done
  done
  for APP_NAME in $(ls ${DIR}app); do
    for APP_VERSION in $(ls ${DIR}app/${APP_NAME}); do
      if [ "$APP_VERSION" != "current" ]; then
        echo  "$listnr "
        echo  "${APP_NAME}:${APP_VERSION} "
        case $USER_APPS in
        *${APP_NAME}\ ${APP_VERSION}*)
          echo  "on "
          echo  $(find_app_description ${DIR}app/${APP_NAME}/${APP_VERSION})
          ;;
        *)
          echo  "off "
          echo  $(find_app_description ${DIR}app/${APP_NAME}/${APP_VERSION})
          ;;
        esac
        listnr=$(($listnr+1))
      fi
    done
  done
}

set_existing_user_apps() {
  get_value_from_conf_file "$1_APPS"
  USER_APPS="$CONF_FILE_VALUE"

  abc=$( echo dialog --stdout --backtitle \"PLLinux\\set users\\$1\\available apps\" --cancel-label "Back" \
         --visit-items --item-help   \
         --buildlist \"Set apps for $1 - non available on left, available on right\" 0 0 10 $(all_apps))
  cmd=$(eval $abc)

  if [ $? = 0 ]; then
    list=""
    listnr=1
    cmd=" $cmd "
    for APP_NAME in $(ls ${DIR}app); do
      for APP_VERSION in $(ls ${DIR}app/${APP_NAME}); do
        if [ "$APP_VERSION" == "current" ]; then
          case $cmd in
          *\ $listnr\ *)
            if [ "$list" != "" ]; then
              list="${list}:"
            fi
            list="${list}${APP_NAME} ${APP_VERSION}"
          esac
          listnr=$(($listnr+1))
        fi
      done
    done
    for APP_NAME in $(ls ${DIR}app); do
      for APP_VERSION in $(ls ${DIR}app/${APP_NAME}); do
        if [ "$APP_VERSION" != "current" ]; then
          case $cmd in
          *\ $listnr\ *)
            if [ "$list" != "" ]; then
              list="${list}:"
            fi
            list="${list}${APP_NAME} ${APP_VERSION}"
          esac
          listnr=$(($listnr+1))
        fi
      done
    done
    change_value_in_conf_file "$1_APPS" "$list"
  fi
}

set_existing_user_features() {
  get_value_from_conf_file "$1_FEATURES"
  USER_FEATURES="$CONF_FILE_VALUE"
  case $USER_FEATURES in
    *\ network*) USER_NETWORK="x on" ;; *) USER_NETWORK="- off" ;;
  esac
  case $USER_FEATURES in
    *\ proc*) USER_PROCESSES="x on" ;; *) USER_PROCESSES="- off" ;;
  esac
  case $USER_FEATURES in
    *\ processesall*) USER_ALL_PROCESSES="x on" ;; *) USER_ALL_PROCESSES="- off" ;;
  esac
  case $USER_FEATURES in
    *\ mnt*) USER_MNT="x on" ;; *) USER_MNT="- off" ;;
  esac
  case $USER_FEATURES in
    *\ reset*) USER_RESET="x on" ;; *) USER_RESET="- off" ;;
  esac

  cmd=$(dialog --stdout --backtitle "PLLinux\set users\\$1\features" --cancel-label "Back" \
         --checklist "Set features for $1, \"x\" shows previous setup" 0 0 10 \
                   "Access to /proc"              $USER_PROCESSES \
                   "Access to allprocesses"       $USER_ALL_PROCESSES \
                   "Access to /mnt"               $USER_MNT \
                   "Access to the network"        $USER_NETWORK \
                   "System reset and shutdown"    $USER_RESET)

  if [ $? = 0 ]; then
    USER_FEATURES="";
    for FEATFEAT in proc processesall mnt network reset; do
      case $cmd in
        *$FEATFEAT*) USER_FEATURES="$USER_FEATURES $FEATFEAT" ;;
      esac
    done
    change_value_in_conf_file "$1_FEATURES" "$USER_FEATURES"
  fi
}

set_existing_user_password() {
  IFS=$IFSORIG
  if [ -d "/mnt/x" ]; then
      dialog --backtitle "PLLinux\set users\\$1\password" \
        --msgbox "Not possible in host system." 10 30
  else
    clear
    passwd $1
    echo "Press any key to continue..."
    read
  fi
}

set_existing_user() {
  while true; do
    cmd=$(dialog --stdout --backtitle "PLLinux\set users\\$1" --cancel-label "Back" \
           --menu "Set user $1" 0 0 6 1 "Available apps" \
                   2 "Background tasks" \
                   3 "Features" \
                   4 "Keyboard and font" \
                   5 "Language (todo)" \
                   6 "Password" )
    if [ $? == 0 ]; then
      case $cmd in
        1) set_existing_user_apps $1 ;;
        2) tasks "$1" ;;
        3) set_existing_user_features $1 ;;
        4) get_value_from_conf_file "$1_KEYB"
           NEW_KEYB="$CONF_FILE_VALUE"
           if [ "$NEW_KEYB" = "" ]; then
             NEW_KEYB="$KEYB"
           fi
           get_value_from_conf_file "$1_FONT"
           NEW_FONT="$CONF_FILE_VALUE"
           if [ "$NEW_FONT" = "" ]; then
             NEW_FONT="$FONT"
           fi
           set_keyboard_font_general_or_user $1 ;;
        6) set_existing_user_password $1 ;;
      esac
    else
      break
    fi
  done
}

set_users() {
  while true; do
    listnr=1
    list=""
    while read -r line; do
      IFS=":" read -r USER_NAME OTHER << EOF
$line
EOF
      list="$list $listnr $USER_NAME"
      listnr=$(($listnr+1))
    done < "${DIR}etc/passwd"
    list="$list $listnr Add(todo)"
    listnr=$(($listnr+1))
    list="$list $listnr Delete(todo)"
    cmd=$(dialog --stdout --backtitle "PLLinux\set users" --cancel-label "Back" \
           --menu "Set users" 0 0 10 $list)
    if [ $? == 0 ]; then
      USRUSR=""
      listnr=1
      while read -r line; do
        IFS=":" read -r USER_NAME OTHER << EOF
$line
EOF
        if [ $listnr = $cmd ]; then
          USRUSR="$USER_NAME"
          break;
        fi
        listnr=$(($listnr+1))
      done < "${DIR}etc/passwd"
      if [ "$USRUSR" = "" ]; then
        add_new_user
      else
        set_existing_user $USRUSR
      fi
    else
      break;
    fi
  done
}

format_install2() {
  dialog --yesno "Really? This is LAST WARNING. $1 will be cleaned from previous data. THIS CANNOT BE REVERSED" 20 40
    if [ $? == 0 ]; then
      clear

      mkfs -V -t ext4 $1

      mkdir /mnt/install
      /app/util-linux/current/bin/mount -t ext4 -o rw,noatime,nodiratime,sync $1 /mnt/install

      cd /mnt/install

      mkdir app
      echo "Copying /app. This will need some time (even 20-30 seconds or more)"
      /app/rsync/current/bin/rsync -a --info=progress2 /app/ app

      mkdir bin
      mkdir dev

      mkdir etc
      /app/rsync/current/bin/rsync -a --info=progress2 /etc/ etc

      mkdir home

      mkdir home/root
      chown 0 home/root
      chgrp 0 home/root
      mkdir home/root/app
      chown 0 home/root/app
      chgrp 0 home/root/app
      mkdir home/root/files
      chown 0 home/root/files
      chgrp 0 home/root/files
      chmod u+rwx home/root
      chmod g-rwx home/root
      chmod o-rwx home/root

      mkdir home/user
      chown 1000 home/user
      chgrp 1000 home/user
      mkdir home/user/app
      chown 1000 home/user/app
      chgrp 1000 home/user/app
      mkdir home/user/files
      chown 1000 home/user/files
      chgrp 1000 home/user/files
      chmod u+rwx home/user
      chmod g-rwx home/user
      chmod o-rwx home/user

      mkdir home/user2
      chown 1001 home/user2
      chgrp 1001 home/user2
      mkdir home/user2/app
      chown 1001 home/user2/app
      chgrp 1001 home/user2/app
      mkdir home/user2/files
      chown 1001 home/user2/files
      chgrp 1001 home/user2/files
      chmod u+rwx home/user2
      chmod g-rwx home/user2
      chmod o-rwx home/user2

      mkdir mnt
      mkdir proc
      mkdir run
      mkdir sys
      mkdir tmp
      mkdir lib64
      if [ ! -d "etc." ]; then ln -s etc etc.; fi
      if [ ! -d "other" ]; then ln -s home/root other; fi

      cd bin
      ln -s /sh sh
      ln -s /app/bash/current/bin/bash bash
      cd ..

      cd lib64
      ln -s /app/glibc/current/lib/ld-linux-x86-64.so.2 ld-linux-x86-64.so.2
      chmod a+x ld-linux-x86-64.so.2
      cd ..

      /app/busybox/current/bin/umount -f .mnt/install
      rmdir /mnt/install

      UUID=$(/app/busybox/current/sbin/blkid | grep $1)
      for PAR in $UUID; do
        case $PAR in
        *UUID*)
          ROOT_DEVICE_ID=${PAR#UUID=\"}
          ROOT_DEVICE_ID=${ROOT_DEVICE_ID%\"}
          ;;
        esac
      done

      echo '#!/bin/sh' > /tmp/42_custom
      echo 'exec tail -n +3 $0' >> /tmp/42_custom
      echo menuentry 'PLLINUX2' --class ubuntu --class gnu-linux --class gnu --class os \$menuentry_id_option 'PL22' { >> /tmp/42_custom
      echo set root='hd1,gpt1' >> /tmp/42_custom
      echo   echo 'Loading PLLINUX ...' >> tmp/42_custom
      echo   linux /app/kernel/current/bzImage root=UUID=$ROOT_DEVICE_ID rw >> /tmp/42_custom
      echo   initrd /app/initramfs/current/initramfs.gz >> /tmp/42_custom
      echo } >> /tmp/42_custom

      chmod a+x /tmp/42_custom

      echo System cloned into $1 partition. Example GRUB file for starting it saved in the /tmp/42_custom file.
      read x
    fi
}

format_install() {
  dialog --yesno "Do you want to format and use partition $1 for new installation? THIS CANNOT BE REVERSED" 20 40
  if [ $? == 0 ]; then
    format_install2 $1
  fi
}

process_one_disk() {
  while true; do
    disks=$(parted -l -m 2> /dev/null)
    thisdisk=0
    list=""
    listnr=1
    while read -r line; do
      if [ "$thisdisk" = "0" ]; then
        case $line in
          $1*) thisdisk=1
        esac
      else
        if [ "$line" = "" ]; then
          thisdisk=0
        else
          IFS=":" read -r PART_NUMER PART_START PART_END PART_SIZE PART_SYSTEM PART_OTHER << EOF
$line
EOF
          list="$list $listnr Formatinstall${PART_SYSTEM}_${PART_SIZE} "
          listnr=$(($listnr+1))
        fi
      fi
    done <<< "$disks"
    cmd=$(dialog --stdout --backtitle "PLLinux/install to other disk/device $1" --cancel-label "Back" \
           --menu "Disk $1" 0 0 6 $list $listnr "Partition disk with cfdisk" )
    if [ $? == 0 ]; then
      if [ "$cmd" = "$listnr" ]; then
        cfdisk $1
      else
        format_install $1p$cmd
      fi
    else
      break
    fi
  done
}

install_to() {
  defnum=1
  while true; do
    disks=$(parted -l -m 2> /dev/null | grep /dev)
    if [ "$disks" = "" ]; then
      dialog --backtitle "PLLinux\install to other partition" \
        --msgbox "No disks detected. Looks like running from mc sandbox or lack of rights/permissions." 10 30
      return
    fi
    listnr=1
    list=""
    while read -r line; do
      IFS=":" read -r DEV_NAME OTHER << EOF
$line
EOF
      list="$list $listnr $DEV_NAME "
      listnr=$(($listnr+1))
    done <<< "$disks"
    cmd=$(dialog --stdout --backtitle "PLLinux\install to other disk" --cancel-label "Back" \
           --default-item $defnum \
           --menu "Install PLLinux to other partition or disk" 0 0 6 $list )
    if [ $? == 0 ]; then
        listnr=1
        list=""
        DEVDEV=""
        while read -r line; do
          IFS=":" read -r DEV_NAME OTHER << EOF
$line
EOF
          if [ "$listnr" == "$cmd" ]; then
            DEVDEV=$DEV_NAME
            defnum=$listnr
          fi
          listnr=$(($listnr+1))
        done <<< "$disks"
        # this must be called after while
        process_one_disk $DEVDEV
    else
      break
    fi
  done
}

get_time_info() {
  if [ "$1" = "\*" ]; then
    echo "not set"
  else
    case $1 in
    */*)
      echo "every $1" ;;
    *)
      echo "at $1" ;;
    esac
  fi
}

task_schedule() {
  STASK=0
  while true; do
    cmd=$(dialog --stdout --backtitle "PLLinux $1 $2" --cancel-label "Back" \
      --form "Pls provide values, you can put intervals or separate values with comma, star means no setup, spaces will be deleted" 0 0 8 \
      "Minute (1-59)" 1 1 "$SMINUTE" 1 20 15 0 \
      "Hour (0-23)" 2 1 "$SHOUR" 2 20 15 0 \
      "Month day (1-31)" 3 1 "$SDAY" 3 20 15 0 \
      "Month (1-12)" 4 1 "$SMONTH" 4 20 15 0 \
      "Day of week (0-6)" 5 1 "$SDOW" 5 20 15 0 )
    if [ $? == 0 ]; then
      linenr=1
      while read -r line; do
        case $linenr in
        1) SMINUTE="$line" ;;
        2) SHOUR="$line" ;;
        3) SDAY="$line" ;;
        4) SMONTH="$line" ;;
        5) SDOW="$line" ;;
        esac
        linenr=$(($linenr+1))
        STASK=1
      done <<< "$cmd"
      break
    else
      break;
    fi
  done
}

task_user() {
  STASK=0
    listnr=1
    list=""
    while read -r line; do
      IFS=":" read -r USER_NAME OTHER << EOF
$line
EOF
      list="$list $listnr $USER_NAME"
      listnr=$(($listnr+1))
    done < "${DIR}etc/passwd"

    cmd=$(dialog --stdout --backtitle \"$PROMPT\\background tasks scheduler\" --cancel-label "Back" \
       --menu \"User starting task\" 0 0 8 \
       $list )
echo $list >> /tmp/x
    if [ $? == 0 ]; then
      STASK=1
      SUSER="$cmd"
    fi
}

task_command() {
  STASK=0
    cmd=$(dialog --stdout --backtitle "PLLinux" --cancel-label "Back" \
      --inputbox "Pls enter command" 15 100 "$SCOM" )
    if [ $? == 0 ]; then
      if [ "$cmd" == "" ]; then
        continue;
      fi
      STASK=1
      SCOM="$cmd"
      break;
    else
      break;
    fi
}

tasks_list() {
    listnr=1
    while read -r line; do
      IFS=" " read -r TASK_MIN TASK_HOUR TASK_DOM TASK_MONTH TASK_DOW TASK_COMMAND << EOF
$line
EOF
      SCHEDULE=""
      IFS=","
      if [ "${TASK_DOW}" != "*" ]; then
        for PERIOD in "$TASK_DOW"; do
          case $PERIOD in
          0) SCHEDULE="$SCHEDULE every Mon" ;;
          1) SCHEDULE="$SCHEDULE every Tue" ;;
          2) SCHEDULE="$SCHEDULE every Wed" ;;
          3) SCHEDULE="$SCHEDULE every Thu" ;;
          4) SCHEDULE="$SCHEDULE every Fri" ;;
          5) SCHEDULE="$SCHEDULE every Sat" ;;
          6) SCHEDULE="$SCHEDULE every Sun" ;;
          esac
        done
      else
        SCHEDULE="$SCHEDULE every week day"
      fi
      if [ "${TASK_DOM}" != "*" ]; then
        for PERIOD in "$TASK_DOM"; do
          if [ "$PERIOD" != "*" ]; then
            if [ "${TASK_MONTH}" != "*" ]; then
              for PERIOD2 in "$TASK_MONTH"; do
                case $PERIOD2 in
                1) SCHEDULE="$SCHEDULE $PERIOD Jan" ;;
                2) SCHEDULE="$SCHEDULE $PERIOD Feb" ;;
                3) SCHEDULE="$SCHEDULE $PERIOD Mar" ;;
                4) SCHEDULE="$SCHEDULE $PERIOD Apr" ;;
                5) SCHEDULE="$SCHEDULE $PERIOD May" ;;
                6) SCHEDULE="$SCHEDULE $PERIOD Jun" ;;
                7) SCHEDULE="$SCHEDULE $PERIOD Jul" ;;
                8) SCHEDULE="$SCHEDULE $PERIOD Aug" ;;
                9) SCHEDULE="$SCHEDULE $PERIOD Sep" ;;
                10) SCHEDULE="$SCHEDULE $PERIOD Oct" ;;
                11) SCHEDULE="$SCHEDULE $PERIOD Nov" ;;
                12) SCHEDULE="$SCHEDULE $PERIOD Dec" ;;
                esac
              done
            else
              SCHEDULE="$SCHEDULE every month day $PERIOD"
            fi
          fi
        done
      else
        SCHEDULE="$SCHEDULE every month day"
      fi
      if [ "${TASK_HOUR}" != "*" ]; then
        for PERIOD in ${TASK_HOUR}; do
          if [ "$PERIOD" != "*" ]; then
            SCHEDULE="${SCHEDULE} hour ${PERIOD}"
            if [ "${TASK_MIN}" != "*" ]; then
              for PERIOD2 in "${TASK_MIN}"; do
                if [ "$PERIOD2" != "*" ]; then
                   SCHEDULE="${SCHEDULE}:${PERIOD2}"
                fi
              done
            else
              SCHEDULE="${SCHEDULE} every min"
            fi
          fi
        done
      else
        if [ "${TASK_MIN}" != "*" ]; then
            for PERIOD2 in "${TASK_MIN}"; do
              if [ "$PERIOD2" != "*" ]; then
                 SCHEDULE="${SCHEDULE} every hour min ${PERIOD2}"
              fi
            done
        fi
      fi
      if [ "${SCHEDULE}" == "" ]; then
        SCHEDULE=" every min of every day"
      fi
      SCHEDULE="${SCHEDULE/every week day every month day/every day}"
      IFS=$IFSORIG
      echo "$listnr "
      echo \"${SCHEDULE:1} - $TASK_COMMAND\"
      listnr=$(($listnr+1))
    done < "${DIR}etc/$1"
    echo " $listnr "
    echo "Add\(todo\)"
echo "c$listnr">>/tmp/xx
}

tasks() {
echo 1\"$1\" 2$2 >> /tmp/xx
  if [ "$1" = "crontab" ]; then
    PROMPT="PLLinux";
    PROMPT2="";
  else
    PROMPT="PLLinux\set users\\$1";
    PROMPT2=" for $1";
  fi
  listnr3=1
  while true; do
    abc=$(echo dialog --stdout --backtitle \"$PROMPT\\background tasks scheduler\" --cancel-label "Back" \
           --default-item $listnr3 \
       --menu \"Commands run$PROMPT2 in the background in the specified time\" 0 0 8 \
       $(tasks_list $1) )
    cmd=$(eval $abc)
    if [ $? == 0 ]; then
echo "a$cmd b$listnr">>/tmp/xx
      listnr3=$cmd
      case $cmd in
      $listnr)
        SMINUTE="*"
        SHOUR="*"
        SDAY="*"
        SMONTH="*"
        SDOW="*"
        SCOM=""
        task_schedule $listnr $1
echo "dddd">>/tmp/xx
echo 1\"$1\" 2$2 >> /tmp/xx
        if [ "$1" = "crontab" ]; then
          if [ $STASK = 1 ]; then
            task_user
          fi
        fi
        if [ $STASK = 1 ]; then
          task_command
        fi
        if [ $STASK = 1 ]; then
          if [ "$1" = "crontab" ]; then
            echo "$SMINUTE $SHOUR $SDAY $SMONTH $SDOW $USER $SCMD " >> ${DIR}etc/$1
          else
            echo "$SMINUTE $SHOUR $SDAY $SMONTH $SDOW $SCMD " >> ${DIR}etc/$1
          fi
        fi
        ;;
      *)
        listnr=1
        while read -r line; do
          if [ "$1" = "crontab" ]; then
            IFS=" " read -r TASK_MIN TASK_HOUR TASK_DOM TASK_MONTH TASK_DOW TASK_USR TASK_COMMAND << EOF
$line
EOF
          else
            IFS=" " read -r TASK_MIN TASK_HOUR TASK_DOM TASK_MONTH TASK_DOW TASK_COMMAND << EOF
$line
EOF
          fi
          if [ "$listnr" = "$cmd" ]; then
            SMINUTE="$TASK_MIN"
            SHOUR="$TASK_HOUR"
            SDAY="$TASK_DOM"
            SMONTH="$TASK_MONTH"
            SDOW="$TASK_DOW"
            SCOM="$TASK_COMMAND"
            SUSR="1"
          fi
          listnr=$(($listnr+1))
        done < "${DIR}etc/$1"
        task_schedule $listnr3
        if [ $STASK = 1 ]; then
          task_command
        fi
        if [ "$1" = "crontab" ]; then
          if [ $STASK = 1 ]; then
            task_user
          fi
        fi
        if [ $STASK = 1 ]; then
          listnr2=1
          file_content=$(cat ${DIR}etc/$1)
          echo -n "" > ${DIR}etc/$1
          while IFS= read -r line; do
            if [ "$listnr2" != "$listnr3" ]; then
              echo "$line" >> ${DIR}etc/$1
            else
              if [ "$1" = "crontab" ]; then
                echo "$SMINUTE $SHOUR $SDAY $SMONTH $SDOW $SCOM" >> ${DIR}etc/$1
              else
                echo "$SMINUTE $SHOUR $SDAY $SMONTH $SDOW $SUSER $SCOM" >> ${DIR}etc/$1
              fi
            fi
            listnr2=$(($listnr2+1))
          done <<< "$file_content"
        fi
        ;;
      esac
    else
      break;
    fi
  done
}

service() {
  while true; do
    cmd=$(dialog --stdout --backtitle "PLLinux\background services\\$1" --cancel-label "Back" \
       --menu "Welcome to the PLLinux configuration" 0 0 8 \
       1 stop 2 start 3 restart )
    if [ $? = 0 ]; then
      case $cmd in
      1) cmd2=$(dinitctl stop $1)
         dialog --msgbox "$cmd2" 10 30 ;;
      2) cmd2=$(dinitctl start $1)
         dialog --msgbox "$cmd2" 10 30 ;;
      3) cmd2=$(dinitctl restart $1)
         dialog --msgbox "$cmd2" 10 30 ;;
      esac
    else
      break;
    fi
  done
}

all_services() {
    servicess=$(dinitctl list)
    listnr=1
    while read -r line; do
      IFS=" " read -r SERVICE_NAME X SERVICE_PID << EOF
${line:11}
EOF
      if [ "$SERVICE_NAME" != "boot" ]; then
        DESC="-"
        while read -r line2; do
          case $line2 in
          \#* )
             DESC=$line2 ;;
          esac
          break
        done < "/etc/dinit.d/$SERVICE_NAME"
        echo " $listnr "
        echo \"$SERVICE_NAME - $(dinitctl is-started $SERVICE_NAME) \"
        echo \"$DESC\"
        listnr=$(($listnr+1))
      fi
    done <<< $servicess
}

services() {
    if [ ! -d "/etc/dinit.d" ]; then
      dialog --backtitle "PLLinux\\backgroud services" --msgbox "No services detected. Looks like running from host or lack of rights/permissions." 10 30
      return
    fi
  while true; do
    abc=$(echo dialog --stdout --backtitle \"PLLinux\\background services\" --cancel-label \"Quit\" --item-help \
       --menu \"Services support is provided by dinit package\" 0 0 8 \
       $(all_services))
    cmd=$(eval $abc)
    if [ $? = 0 ]; then
      servicess=$(dinitctl list)
      listnr=1
      while read -r line; do
        IFS=" " read -r SERVICE_NAME X SERVICE_PID << EOF
${line:11}
EOF
        if [ "$SERVICE_NAME" != "boot" ]; then
          if [ "$listnr" = "$cmd" ]; then
             break
          fi
          listnr=$(($listnr+1))
        fi
      done <<< $servicess
      service $SERVICE_NAME
    else
      break;
    fi
  done
}

disks() {
  defnum=1
  while true; do
    disks=$(parted -l -m 2> /dev/null | grep /dev)
    if [ "$disks" = "" ]; then
      dialog --backtitle "PLLinux\device manager\disks" \
        --msgbox "No disks detected. Looks like running from mc sandbox or lack of rights/permissions." 10 30
      return
    fi
    listnr=1
    list=""
    while read -r line; do
      IFS=":" read -r DEV_NAME OTHER << EOF
$line
EOF
      list="$list $listnr $DEV_NAME "
      listnr=$(($listnr+1))
    done <<< "$disks"
    cmd=$(dialog --stdout --backtitle "PLLinux\install to other disk" --cancel-label "Back" \
           --default-item $defnum \
           --menu "Show disk properties" 0 0 6 $list )
    if [ $? == 0 ]; then
        listnr=1
        list=""
        DEVDEV=""
        while read -r line; do
          IFS=":" read -r DEV_NAME OTHER << EOF
$line
EOF
          if [ "$listnr" == "$cmd" ]; then
            DEVDEV=$DEV_NAME
            defnum=$listnr
          fi
          listnr=$(($listnr+1))
        done <<< "$disks"
        # this must be called after while
        dialog --msgbox "$(smartctl -a $DEVDEV)" 100 100
    else
      break
    fi
  done
}

devices() {
  while true; do
    cmd=$(dialog --stdout --backtitle "PLLinux\device manager" --cancel-label "Back" --menu "Welcome to the device manager" 0 0 8 \
       1 disks 2 UEFI 3 PCI )
    if [ $? = 0 ]; then
      case $cmd in
      1) disks ;;
      2) dialog --backtitle "PLLinux\device manager\UEFI" --msgbox "$(dmidecode)" 100 90 ;;
      3) dialog --backtitle "PLLinux\device manager\PCI" --msgbox "$(lspci -vvv)" 100 90 ;;
      esac
    else
      break;
    fi
  done
}


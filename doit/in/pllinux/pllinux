kernel_modules_list() {
  IS_LOADED=$(lsmod)
  listnr=1
  APP_LIST=$(${DIR}app/busybox/current/bin/ls ${DIR}app)
  for APP_NAME in $APP_LIST; do
    if [ -e "${DIR}app/${APP_NAME}/current/readme.md" ]; then
      sectionModules=0
      while read -r line; do
        if [ "$line" = "**Modules**" ]; then
          sectionModules=1
        elif [ "$line" = "" ]; then
          sectionModules=0;
        elif [ "$sectionModules" = 1 ]; then
          IFS=":"
          for folder in $line; do
            if [ -d "${DIR}app/${APP_NAME}/current/$folder" ]; then
              PARAMS=$(find ${DIR}app/${APP_NAME}/current/$folder -type f -name \*.ko.xz)
              while read -r line2; do
                LINE2X=${line2##*/}
                LINE2X=${LINE2X%%.ko.xz*}
                case $line2 in
                *$1*) echo " $listnr "
                      case $IS_LOADED in
                      *${LINE2X}*) echo  \" $line2 - STARTED\" ;;
                      *) echo  " $line2"
                      esac
                      listnr=$(($listnr+1))
                esac
              done <<< $PARAMS
            fi
          done
        fi
      done < ${DIR}app/${APP_NAME}/current/readme.md
    fi
  done
}

kernel_modules() {
    cmd=$(dialog --stdout --backtitle "PLLinux\kernel modules\filter" --cancel-label "Back" \
      --inputbox "Kernel module filename filter. Empty value means everything. Case sensitive." 15 100 "" )
    if [ $? == 0 ]; then
      FILTER="$cmd"
    else
      return
    fi

  listnr3=1
  while true; do
    abc=$(echo dialog --stdout --backtitle \"PLLinux\\kernel modules\\list\" --cancel-label "Back" \
           --default-item $listnr3 \
       --menu \"Linux kernel modules \(filter: '\"$FILTER\"'\)\" 0 0 8 \
       $(kernel_modules_list $FILTER) )
    cmd=$(eval $abc)
    if [ $? = 0 ]; then
      listnr3="$cmd"
      IS_LOADED=$(lsmod)
      foundname=""
      isstarted=0
      listnr=1
      APP_LIST=$(${DIR}app/busybox/current/bin/ls ${DIR}app)
      for APP_NAME in $APP_LIST; do
        if [ -e "${DIR}app/${APP_NAME}/current/readme.md" ]; then
          sectionModules=0
          while read -r line; do
            if [ "$line" = "**Modules**" ]; then
              sectionModules=1
            elif [ "$line" = "" ]; then
              sectionModules=0;
            elif [ "$sectionModules" = 1 ]; then
              IFS=":"
              for folder in $line; do
                if [ -d "${DIR}app/${APP_NAME}/current/$folder" ]; then
                  PARAMS=$(find ${DIR}app/${APP_NAME}/current/$folder -type f -name \*.ko.xz)
                  while read -r line2; do
                    case $line2 in
                    *$FILTER*)
                      if [ "$cmd" = "$listnr" ]; then
                        LINE2X=${line2##*/}
                        LINE2X=${LINE2X%%.ko.xz*}
                        case $IS_LOADED in
                        *${LINE2X}*) isstarted=1
                        esac
                        foundname="$line2"
                      fi
                      listnr=$(($listnr+1))
                    esac
                    if [ "$foundname" != "" ]; then break; fi
                  done <<< $PARAMS
                fi
                if [ "$foundname" != "" ]; then break; fi
              done
              IFS=$IFSORIG
            fi
            if [ "$foundname" != "" ]; then break; fi
          done < ${DIR}app/${APP_NAME}/current/readme.md
        fi
        if [ "$foundname" != "" ]; then break; fi
      done
      kernel_module $foundname $isstarted
    else
      break;
    fi
  done
}


      "IP4 gateway (ignored with DHCP)" 5 1 "$ETH_IP4_GATEWAY" 5 50 20 0 )
    if [ $? == 0 ]; then
        linenr=1
        while read -r line; do
          case $linenr in
          1) change_value_in_conf_file "ETH_START" "$line" ;;
          2) ETH_IP4="$line"
             change_value_in_conf_file "ETH_IP4" "$line" ;;
          3) ETH_IP4_NETMASK="$line"
             change_value_in_conf_file "ETH_IP4_NETMASK" "$line" ;;
          4) ETH_IP4_GATEWAY="$line"
             change_value_in_conf_file "ETH_IP4_GATEWAY" "$line" ;;
          esac
          linenr=$(($linenr+1))
        done <<< "$cmd"
        network_change_config_file "$ETH_IP4" "$ETH_IP4_NETMASK" "$ETH_IP4_GATEWAY"
    fi

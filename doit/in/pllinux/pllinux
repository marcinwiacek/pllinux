  /app/kbd/current/bin/setfont -C /dev/tty1 $FONT
  /app/kbd/current/bin/loadkeys /app/kbd/current/share/keymaps/i386/$KEYB
}

set_existing_user_features() {
  get_value_from_conf_file "$1_FEATURES"
  USER_FEATURES="$CONF_FILE_VALUE"
  case $USER_FEATURES in
  *network*) USER_NETWORK="x on" ;; *) USER_NETWORK="- off" ;;
  esac
  case $USER_FEATURES in
  *processes*) USER_PROCESSES="x on" ;; *) USER_PROCESSES="- off" ;;
  esac
  case $USER_FEATURES in
  *mnt*) USER_MNT="x on" ;; *) USER_MNT="- off" ;;
  esac
  case $USER_FEATURES in
  *reset*) USER_RESET="x on" ;; *) USER_RESET="- off" ;;
  esac

  cmd=$(dialog --stdout --backtitle "PLLinux/set users/set user $1/features" --cancel-label "Back" \
         --checklist "Set features for the $1, \"x\" shows previous setup" 0 0 10 \
                   "Access to all user processes"   $USER_PROCESSES \
                   "Access to /mnt"            $USER_MNT \
                   "Access to the network"     $USER_NETWORK \
                   "System reset and shutdown" $USER_RESET)

  if [ $? = 0 ]; then
    USER_FEATURES="";
    case $cmd in
    *processes*) USER_FEATURES="processes" ;;
    esac
    case $cmd in
    */mnt*) USER_FEATURES="$USER_FEATURES mnt" ;;
    esac
    case $cmd in
    *network*) USER_FEATURES="$USER_FEATURES network" ;;
    esac
    case $cmd in
    *reset*) USER_FEATURES="$USER_FEATURES reset" ;;
    esac
    change_value_in_conf_file "$1_FEATURES" "$USER_FEATURES"
  fi
}

set_existing_user_password() {
  IFS=$IFSORIG
  clear
  passwd $1
  echo "Press any key to continue..."
  read
}

set_existing_user() {
  while true; do
    cmd=$(dialog --stdout --backtitle "PLLinux/set users/set user $1" --cancel-label "Back" \
           --menu "Set user $1" 0 0 6 1 "Available apps" \
                   2 "Features" \
                   3 "Keyboard and font" \
                   4 "Language (todo)" \
                   5 "Password" )
    if [ $? == 0 ]; then
      case $cmd in
        1) set_existing_user_apps $1 ;;
        2) set_existing_user_features $1 ;;
        3) set_existing_user_keyboard_font $1 ;;
        5) set_existing_user_password $1 ;;
      esac
    else
      break
    fi
  done
}

set_users() {
  while true; do
    listnr=1
    list=""
    while read -r line; do
      IFS=":" read -r USER_NAME OTHER << EOF
$line
EOF
      list="$list $listnr $USER_NAME"
      listnr=$(($listnr+1))
    done < "${DIR}etc/passwd"
    list="$list $listnr Add(todo)"
    cmd=$(dialog --stdout --backtitle "PLLinux/set users" --cancel-label "Back" \
           --menu "Set users" 0 0 10 $list)
    if [ $? == 0 ]; then
      USRUSR=""
      listnr=1
      while read -r line; do
        IFS=":" read -r USER_NAME OTHER << EOF
$line
EOF
        if [ $listnr = $cmd ]; then
          USRUSR="$USER_NAME"
          break;
        fi
        listnr=$(($listnr+1))
      done < "${DIR}etc/passwd"
      if [ "$USRUSR" = "" ]; then
        add_new_user
      else
        set_existing_user $USRUSR
      fi
    else
      break;
    fi
  done
}

CFGFILE="etc/pllinux.conf"
if [ "$1" != "" ]; then
  CFGFILE="$1"
fi
set_general_config
if [ "$1" != "" ]; then
  if [ "$2" = "LANG" ]; then
    echo $LANG
  fi
  exit
fi


while true; do
  cmd=$(dialog --stdout --backtitle "PLLinux" --cancel-label "Quit" --menu "Welcome to the PLLinux configuration" 0 0 5 \
       1 "Apps (todo)" \
       2 "App language (todo) - $LANG" \
       3 "Keyboard and font   - $KEYB, $FONT" \
       4 "Timezone            - $TIMEZONE" \
       5 "Users" )
  if [ $? == 0 ]; then
    case $cmd in
    3) set_keyboard_font ;;
    4) set_time_zone ;;
    5) set_users ;;
    esac
  else
    break
  fi
done
clear
set_general_config

  for APP_NAME in $(ls ${DIR}app); do
    appnum=0
    case $SYSTEM_APPS in
      *${APP_NAME}*)
        for APP_VERSION in $(ls ${DIR}app/${APP_NAME}); do
          appnum=$(($appnum+1))
        done
      ;;
    esac
    #cannot delete system apps when there is only one version installed
    if [ "$appnum" != 2 ]; then
      for APP_VERSION in $(ls ${DIR}app/${APP_NAME}); do
        if [ "$APP_VERSION" != "current" ]; then
          echo  "$listnr "
          CURRENT=$(realpath ${DIR}app/${APP_NAME}/current)
          if [ "$CURRENT" = "${DIR}app/${APP_NAME}/${APP_VERSION}" ]; then
            echo  \"${APP_NAME}:${APP_VERSION} - current - $(du ${DIR}app/${APP_NAME}/${APP_VERSION} -s -h -c -S | grep total)\"
          else
            echo  \"${APP_NAME}:${APP_VERSION} - $(du ${DIR}app/${APP_NAME}/${APP_VERSION} -s -h -c -S | grep total)\"
          fi
          echo  " off "
          echo  $(find_app_description ${DIR}app/${APP_NAME}/${APP_VERSION})
          listnr=$(($listnr+1))
        fi
      done
    fi
  done
}

delete_system_apps() {
  abc=$( echo dialog --stdout --backtitle \"PLLinux\\apps\\delete\" --cancel-label "Back" \
         --visit-items --item-help   \
         --buildlist \"Marking apps for deleting - installed on left, marked for delete on right\" 0 0 10 $(all_system_apps))
  cmd=$(eval $abc)

  if [ $? = 0 ]; then
    list=""
    listnr=1
  fi
}

get_repo_updates() {
  REPO_UPDATES=""
  LINE_NUM=1
  rm -r -f /tmp/apprepo 2> /dev/null
  while read -r repo_line; do
    IFS=" " read -r REPO_URL REPO_FIRST_PUBLIC_KEY REPO_SECOND_PUBLIC_KEY << EOF
$repo_line
EOF
    if [ "${REPO_URL:0:5}" = "https" ]; then
      mkdir /tmp/apprepo 2> /dev/null
      mkdir /tmp/apprepo/${LINE_NUM} 2> /dev/null
      LINK=${REPO_URL/;/:}
#echo "$LINK"
#echo "${LINK/[*]/app.repo.updates}"
      echo -n "Getting repo.updates..."
      wget -O /tmp/apprepo/${LINE_NUM}/app.repo.updates ${LINK/[*]/app.repo.updates} > /dev/null 2> /dev/null
      if [ $? -eq 0 ]; then
        echo -n "getting first key..."
        wget -O /tmp/apprepo/${LINE_NUM}/app.publickey1 $REPO_FIRST_PUBLIC_KEY > /dev/null 2> /dev/null
        if [ $? -eq 0 ]; then
          if [ $REPO_FIRST_PUBLIC_KEY = $REPO_SECOND_PUBLIC_KEY ]; then
            echo "repo $REPO_URL issue - the same public key (worse security)"
            cp /tmp/apprepo/${LINE_NUM}/app.publickey1 /tmp/apprepo/${LINE_NUM}/app.publickey2
          else 
            echo -n "getting second key..."
            wget -O /tmp/apprepo/${LINE_NUM}/app.publickey2 $REPO_SECOND_PUBLIC_KEY > /dev/null 2> /dev/null
          fi
          if cmp -s /tmp/apprepo/${LINE_NUM}/app.publickey1 /tmp/apprepo/${LINE_NUM}/app.publickey2; then
            echo
            while read -r line; do
              REPO_UPDATES="$REPO_UPDATES$line $REPO_URL /tmp/apprepo/${LINE_NUM}/app.publickey1
"
            done < "/tmp/apprepo/${LINE_NUM}/app.repo.updates"
          else
            echo repo $REPO_URL problem - both public keys are not the same. Skipping
          fi
        fi
      fi
      LINE_NUM=$LINE_NUM+1
    else
      REPO_DIR=${REPO_URL//[*]/}
      if [ ! -d "$REPO_DIR" ]; then
        echo Repo directory $REPO_DIR not found. Skipping
      elif [ ! -f "${REPO_URL/[*]/app.repo.updates}" ]; then
        echo "Repo directory $REPO_URL without app.repo.updates file. Skipping"
      else
        if cmp -s $REPO_FIRST_PUBLIC_KEY $REPO_SECOND_PUBLIC_KEY; then
          while read -r line; do
            REPO_UPDATES="$REPO_UPDATES$line $(pwd)/$REPO_URL $(pwd)/$REPO_FIRST_PUBLIC_KEY
"
          done < "${REPO_URL/[*]/app.repo.updates}"
        else
          echo Repo $REPO_URL problem - both public keys are not the same. Skipping
        fi
      fi
    fi
  done < "${DIR}etc/app.repos"
#  echo "$REPO_UPDATES"
}

install_system_apps() {
  abc=$( echo dialog --stdout --backtitle \"PLLinux\\apps\\install from repo\" --cancel-label "Back" \
         --visit-items --item-help   \
         --buildlist \"Marking apps for deleting - installed on left, marked for delete on right\" 0 0 10 $(all_system_apps))
  cmd=$(eval $abc)

  if [ $? = 0 ]; then
    list=""
    listnr=1
  fi
}

set_system_apps() {
  while true; do
    cmd=$(dialog --stdout --backtitle "PLLinux\apps" --cancel-label "Back" --menu "Manage apps in the /app" 0 0 8 \
       1 delete 2 "install from repo" 3 "install from file" )
    if [ $? = 0 ]; then
      case $cmd in
      1) delete_system_apps ;;
      2) install_system_apps ;;
      esac
    else
      break;
    fi
  done
}


    fi
  done
}

swap_file() {
    cmd=$(dialog --stdout --backtitle "PLLinux\\swap file" --cancel-label "Back" \
      --form "Pls provide swap params" 0 0 8 \
      "Size in MB (0 disables it)" 1 1 "0" 1 50 10 0 \
      "How aggressive is moving to swap (0-100)" 2 1 "10" 2 50 10 0 \
      "Using zswap (compress RAM before saving to swap)" 3 1 "1" 3 50 10 0 )
    if [ $? == 0 ]; then
        linenr=1
        while read -r line; do
          case $linenr in
          1) if [ "$line" = "0" ]; then
               swapoff /swapfile
               rm /swapfile
             else
               swapoff /swapfile || true
               rm /swapfile || true
               fallocate -l ${line}M /swapfile
               chmod 600 /swapfile
               mkswap /swapfile
               swapon /swapfile
             fi ;;
          2) sysctl vm.swappiness=$line ;;
          esac
          linenr=$(($linenr+1))
        done <<< "$cmd"
    fi
}


all_services() {
  servicess=$(dinitctl list)
  listnr=1
  while read -r line; do
    IFS=" " read -r SERVICE_NAME X SERVICE_PID << EOF
${line:11}
EOF
    if [ "$SERVICE_NAME" != "boot" ]; then
      DESC="-"
      while read -r line2; do
        case $line2 in
          \#* )
             DESC=$line2 ;;
        esac
        break
      done < "/etc/dinit.d/$SERVICE_NAME"
      echo " $listnr "
      echo \"$SERVICE_NAME - $(dinitctl is-started $SERVICE_NAME) \"
      echo \"$DESC\"
      listnr=$(($listnr+1))
    fi
  done <<< $servicess
}


      --inputbox "Enter filename for log (cannot be empty). Normally /log/(name) for permanent logs and /log/tmp/(name) for temporary logs." 15 100 "${LOG_FILE}" )
    if [ $? == 0 ]; then
      if [ "$cmd" == "" ]; then
        continue;
      fi
      eeeee=0
      LOG_FILE2 = ""
      while read -r line; do
        case $line in
          *module*) ;;
          *#*) ;;
          *) IFS=" " read -r LOG_RULES2 LOG_FILE2 << EOF
$line
EOF
        esac
        if [ "$LOG_FILE2" == "$cmd" ]; then
          if [ "$1" != "$LOG_RULES2" ] || [ "$1" = "" ]; then
            eeeee=1
            break
          fi
        fi
      done < "${DIR}etc/rsyslog.conf"
      if [ "$eeeee" = "1" ]; then
        dialog --backtitle "$PROMPT\\task command" \
          --msgbox "Filename used for other rule $LOG_RULES2. Try again" 10 30
        continue
      fi
      TASKSTEPNR=$(($TASKSTEPNR+1))
      LOG_FILE="$cmd"
    else
      TASKSTEPNR=$(($TASKSTEPNR-1))
    fi
    break;
  done
}


tasks() {
  listnr3=1
  tasks_file_list $1
  while true; do
  if [ "$1" = "crontab" ]; then
    PROMPT="PLLinux";
    PROMPT2="";
  else
    PROMPT="PLLinux\set users\\$1";
    PROMPT2=" for $1";
  fi
  PROMPT="$PROMPT\\background tasks scheduler"
  abc=$(echo dialog --stdout --backtitle \"$PROMPT\" --cancel-label "Back" \
           --default-item $listnr3 \
       --menu \"Commands run$PROMPT2 in the background in the specified time\" 0 0 8 \
       $(tasks_list) )
  cmd=$(eval $abc)
  if [ $? == 0 ]; then
    tasks_list_num $1
    listnr3=$cmd
    case $cmd in
    $listnr)
        PROMPT="$PROMPT\\new task"
        SMINUTE="*"
        SHOUR="*"
        SDAY="*"
        SMONTH="*"
        SDOW="*"
        SUSER="root"
        SCMD=""
        SSETUPBYSYSTEM=2
        TASKSTEPNR=1
        while true; do
          case $TASKSTEPNR in
          0) break ;;
          1) task_schedule $listnr $1 ;;
          2) task_command ;;
          3) if [ "$1" != "crontab" ]; then
               TASKSTEPNR=5
             else
               task_user
             fi ;;
          4) task_type ;;
          5) if [ "$SSETUPBYSYSTEM" = "1" ]; then
               echo "$SMINUTE $SHOUR $SDAY $SMONTH $SDOW $SUSER $SCMD" >> ${DIR}etc/crontab
               listnr=1
               for task_fn in $TASK_FILE_LIST; do
                 while read -r line; do
                   if [ "$task_fn" = "crontab" ] && [ "$line" = "$SMINUTE $SHOUR $SDAY $SMONTH $SDOW $SUSER $SCMD" ]; then
                     listnr3=$listnr
                   fi
                   listnr=$(($listnr+1))
                 done < "${DIR}etc/crontab"
               done
             else
               echo "$SMINUTE $SHOUR $SDAY $SMONTH $SDOW $SCMD" >> ${DIR}etc/crond.d/$SUSER
               listnr=1
               for task_fn in $TASK_FILE_LIST; do
                 while read -r line; do
                   if [ "$task_fn" = "crond.d/$SUSER" ] && [ "$line" = "$SMINUTE $SHOUR $SDAY $SMONTH $SDOW $SCMD" ]; then
                     listnr3=$listnr
                   fi
                   listnr=$(($listnr+1))
                 done < "${DIR}etc/$task_fn"
               done
             fi
             break
          esac
        done
        ;;
    $(($listnr+1)) )
        ;;
    *)
        PROMPT="$PROMPT\\edit task"
        listnr=1
        for task_fn in $TASK_FILE_LIST; do
          while read -r line; do
            if [ "$task_fn" = "crontab" ]; then
              IFS=" " read -r TASK_MIN TASK_HOUR TASK_DOM TASK_MONTH TASK_DOW TASK_USR TASK_COMMAND << EOF
$line
EOF
            else
              IFS=" " read -r TASK_MIN TASK_HOUR TASK_DOM TASK_MONTH TASK_DOW TASK_COMMAND << EOF
$line
EOF
              TASK_USR="${task_fn#*/}"
            fi
            if [ "$listnr" = "$cmd" ]; then
              if [ "$task_fn" = "crontab" ]; then
                SSETUPBYSYSTEM=1
              else
                SSETUPBYSYSTEM=2
              fi
              SMINUTE="$TASK_MIN"
              SHOUR="$TASK_HOUR"
              SDAY="$TASK_DOM"
              SMONTH="$TASK_MONTH"
              SDOW="$TASK_DOW"
              SUSER="$TASK_USR"
              SCMD="$TASK_COMMAND"
            fi
            listnr=$(($listnr+1))
          done < "${DIR}etc/$task_fn"
done
          TASKSTEPNR=1
          while true; do
            case $TASKSTEPNR in
            0) break ;;
            1) task_schedule $listnr3 ;;
            2) task_command ;;
            3) if [ "$1" != "crontab" ]; then
                 TASKSTEPNR=5
               else
                 task_user
               fi ;;
            4) task_type ;;
            5) listnr2=1
#fixme: position during changing type
               for task_fn in $TASK_FILE_LIST; do
                 file_content=$(cat ${DIR}etc/$task_fn)
                 echo -n "" > ${DIR}etc/$task_fn
                 while IFS= read -r line; do
                   if [ "$listnr2" != "$listnr3" ]; then
                     echo "$line" >> ${DIR}etc/$task_fn
                   else
                     if [ "$task_fn" = "crontab" ]; then
                       echo "$SMINUTE $SHOUR $SDAY $SMONTH $SDOW $SUSER $SCMD" >> ${DIR}etc/crontab
                     else
                       echo "$SMINUTE $SHOUR $SDAY $SMONTH $SDOW $SCMD" >> ${DIR}etc/$task_fn
                     fi
                   fi
                   listnr2=$(($listnr2+1))
                 done <<< "$file_content"
               done
               break
            esac
          done
          ;;
    esac
  else
    break;
  fi
  done
}

log_feature_type() {
  list=""
  for TYPE in   kern user mail daemon auth syslog lpr news uucp cron authpriv ftp ntp security console priority; do
    case $LOG_TYPE in
    *$TYPE*)
      list="$list $TYPE x on ";
      ;;
    *)
      list="$list $TYPE - off ";
      ;;
    esac
  done
  cmd=$(dialog --stdout --backtitle "PLLinux\set users\\$1\features" --cancel-label "Back" \
         --checklist "Set features for $1, \"x\" shows previous setup" 0 0 10 $list)
  if [ $? == 0 ]; then
    LOG_TYPE=""
    for TYPE in   kern user mail daemon auth syslog lpr news uucp cron authpriv ftp ntp security console priority; do
      case $cmd in
      *$TYPE*)
         if [ "$LOG_TYPE" != "" ]; then LOG_TYPE="$LOG_TYPE,"; fi
         LOG_TYPE="$LOG_TYPE$TYPE";
       ;;
      esac
    done
    TASKSTEPNR=$(($TASKSTEPNR+1))
  else
    TASKSTEPNR=$(($TASKSTEPNR-1))
  fi

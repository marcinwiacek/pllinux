    ETH_IP4_GATEWAY="$CONF_FILE_VALUE"
    cmd=$(dialog --stdout --backtitle "PLLinux\\network" --cancel-label "Back" \
      --form "Pls provide params" 0 0 8 \
      "Enabling eth0 in system startup (0 or 1)" 1 1 "$ETH_START" 1 50 20 0 \

logs() {
  listnr3=1
  while true; do
    PROMPT="PLLinux\\logs"
    abc=$(echo dialog --stdout --backtitle \"$PROMPT\" --cancel-label "Back" \
           --default-item $listnr3 \
       --menu \"Logs saved to files \(temporary or permanent\). Managed by syslogd service\" 0 0 8 \
       $(logs_list) )
    cmd=$(eval $abc)
    if [ $? == 0 ]; then
      listnr=1
      IFS=" "
      while read -r line; do
        case $line in
          *module*) ;;
          *#*) ;;
          *) listnr=$(($listnr+1))
        esac
      done < "${DIR}etc/rsyslog.conf"
      IFS=$IFSORIG

      case $cmd in
      $listnr) # add
        LOG_TYPE=""
        LOG_PRIORITY=""
        TASKSTEPNR=1
        while true; do
          case $TASKSTEPNR in
          0) break; ;;
          1) log_feature_type ;;
          2) log_feature_priority ;;
          3) LOG_FILE="/log/tmp/example_log"
             log_file ;;
          4) if [ ! -f  ${DIR}etc/rsyslog.conf ]; then
               echo "# Created by script pllinux" > ${DIR}etc/rsyslog.conf
               echo "module(load=\"imuxsock\") #SysSock . Annotate=on #local system logging" >> ${DIR}etc/rsyslog.conf
               echo "module(load=\"imkmsg\") #kernel boot messages (from ring buffer and /dev/kmsg). Cannot be used with imklog module" >> ${DIR}etc/rsyslog.conf
             fi
             echo "${LOG_TYPE}.${LOG_PRIORITY} ${LOG_FILE} " >> ${DIR}etc/rsyslog.conf
             dinitctl restart syslogd
             break;;
          esac
        done
        ;;
      *) # edit
        listnr=0
        IFS=" "
        while read -r line; do
          case $line in
            *module*) ;;
            *#*) ;;
            *) IFS=" " read -r LOG_RULES LOG_FILE << EOF
$line
EOF
               listnr=$(($listnr+1))
          esac
          if [ "$cmd" = "$listnr" ]; then
            break;
          fi
        done < "${DIR}etc/rsyslog.conf"
        IFS=$IFSORIG
        OLD_LOG_RULES="$LOG_RULES"
        OLD_LOG_FILE="$LOG_FILE"
        log_entry $LOG_RULES $LOG_FILE
        # dont change file and make extra SSD saves, when not required
        if [ "$OLD_LOG_RULES" != "$LOG_RULES" ] || [ "$OLD_LOG_FILE" != "$LOG_FILE" ]; then
          file_content=$(cat ${DIR}etc/rsyslog.conf)
          echo -n "" > ${DIR}etc/rsyslog.conf
          while read -r line; do
            if [ "$line" = "$OLD_LOG_RULES $OLD_LOG_FILE" ]; then
              if [ "$LOG_RULES" != "" ]; then
                echo "$LOG_RULES $LOG_FILE" >> ${DIR}etc/rsyslog.conf
              fi
            else
              echo "$line" >> ${DIR}etc/rsyslog.conf
            fi
          done <<< "$file_content"
          dinitctl restart syslogd
        fi
        ;;
      esac
    else
      break;
    fi
  done
}

single_service() {
  while true; do
    IS_STARTED=$(dinitctl is-started $1)
    case $IS_STARTED in
    *STARTED* )
      cmd=$(dialog --stdout --backtitle "PLLinux\background services\\$1" --cancel-label "Back" \
         --menu "Welcome to the PLLinux configuration" 0 0 8 \
         1 restart 2 stop 4 "internal log" 5 "history from /log/*/daemon_services syslogd file (if exists, q to quit)" )
      ;;
    *STOPPED* )
      cmd=$(dialog --stdout --backtitle "PLLinux\background services\\$1" --cancel-label "Back" \
         --menu "Welcome to the PLLinux configuration" 0 0 8 \
         3 start 4 "internal log" 5 "history from /log/*/daemon_services syslogd file (if exists, q to quit)" )
    esac
    if [ $? = 0 ]; then
      case $cmd in
      1) cmd2=$(dinitctl restart $1)
         dialog --msgbox "$cmd2" 10 30 ;;
      2) cmd2=$(dinitctl stop $1)
         dialog --msgbox "$cmd2" 10 30 ;;
      3) cmd2=$(dinitctl start $1)
         dialog --msgbox "$cmd2" 10 30 ;;
      4) cmd2=$(dinitctl catlog $1)
         dialog --msgbox "$cmd2" 10 30 ;;
      5) FNAME=""
         if [ -f "/log/daemon_services" ]; then FNAME="/log/daemon_services"; fi
         if [ -f "/log/tmp/daemon_services" ]; then FNAME="/log/tmp/daemon_services"; fi
         if [ "$FNAME" != "" ]; then
           clear
           cat $FNAME | grep $1 | less
         fi
      esac
    else
      break;
    fi
  done
}


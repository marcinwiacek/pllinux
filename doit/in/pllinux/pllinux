set_existing_user_features() {
  get_value_from_conf_file "$1_FEATURES"
  USER_FEATURES="$CONF_FILE_VALUE"
  case $USER_FEATURES in
  *network*) USER_NETWORK="x on" ;; *) USER_NETWORK="- off" ;;
  esac
  case $USER_FEATURES in
  *processes*) USER_PROCESSES="x on" ;; *) USER_PROCESSES="- off" ;;
  esac
  case $USER_FEATURES in
  *mnt*) USER_MNT="x on" ;; *) USER_MNT="- off" ;;
  esac
  case $USER_FEATURES in
  *reset*) USER_RESET="x on" ;; *) USER_RESET="- off" ;;
  esac

  cmd=$(dialog --stdout --backtitle "PLLinux/set users/set user $1/features" --cancel-label "Back" \
         --checklist "Set features for the $1, \"x\" shows previous setup" 0 0 10 \
                   "Access to all user processes"   $USER_PROCESSES \
                   "Access to /mnt"            $USER_MNT \
                   "Access to the network"     $USER_NETWORK \
                   "System reset and shutdown" $USER_RESET)

  if [ $? = 0 ]; then
    USER_FEATURES="";
    case $cmd in
    *processes*) USER_FEATURES="processes" ;;
    esac
    case $cmd in
    */mnt*) USER_FEATURES="$USER_FEATURES mnt" ;;
    esac
    case $cmd in
    *network*) USER_FEATURES="$USER_FEATURES network" ;;
    esac
    case $cmd in
    *reset*) USER_FEATURES="$USER_FEATURES reset" ;;
    esac
    change_value_in_conf_file "$1_FEATURES" "$USER_FEATURES"
  fi
}

change_user_feature() {
  case $USER_FEATURES in
    *$1*)
       NEW_FEAT=""
       IFS=" "
       for FEATURE in $USER_FEATURES; do
         if [ "$FEATURE" != "$1" ]; then
           NEW_FEAT="$NEW_FEAT $FEATURE"
         fi
       done
       IFS=$IFSORIG
       USER_FEATURES="$NEW_FEAT"
       ;;
    *) USER_FEATURES="${USER_FEATURES} $1"
       ;;
  esac
}

set_existing_user() {
  while true; do
    cmd=$(dialog --stdout --backtitle "PLLinux/set users/set user $1" --cancel-label "Back" \
           --menu "Set user $1" 0 0 10 1 "Available apps" \
                   2 "Features" \
                   3 "Keyboard and font" \
                   4 "Language" )
    if [ $? = 0 ]; then
      case $cmd in
        1) set_existing_user_apps $1 ;;
        2) set_existing_user_features $1 ;;
        3) set_keyboard_font_user $1 ;;
      esac
    else
      break
    fi
  done
}

set_users() {
  while true; do
    listnr=1
    list=""
    while read -r line; do
      IFS=":" read -r USER_NAME OTHER << EOF
$line
EOF
      list="$list $listnr $USER_NAME"
      listnr=$(($listnr+1))
    done < "${DIR}etc/passwd"
    list="$list $listnr Add"
    cmd=$(dialog --stdout --backtitle "PLLinux/set users" --cancel-label "Back" \
           --menu "Edit users" 0 0 10 $list)
    if [ $? = 0 ]; then
      listnr=1
      while read -r line; do
        IFS=":" read -r USER_NAME OTHER << EOF
$line
EOF
        if [ $listnr = $cmd ]; then
          set_existing_user $USER_NAME
        fi
        listnr=$(($listnr+1))
      done < "${DIR}etc/passwd"
      if [ $listnr = $cmd ]; then
        add_new_user
      fi
    else
      break;
    fi
  done
}

while true; do
  cmd=$(dialog --stdout --backtitle "PLLinux" --cancel-label "Quit" --menu "Welcome to the PLLinux configuration" 0 0 4 \
       1 "Language          - $LANG" \
       2 "Keyboard and font - $KEYB, $FONT" \
       3 "Timezone          - $TIMEZONE" \
       4 "Users" )
  if [ $? == 0 ]; then
    case $cmd in
    2) set_keyboard_font ;;
    3) set_time_zone ;;
    4) set_users ;;
    esac
  else
    return
  fi
done

#FIXME: dont save, when file is not updated. Save SSD

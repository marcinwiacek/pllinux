tasks() {
  listnr3=1
  while true; do
    tasks_file_list $1
    if [ "$1" = "crontab" ]; then
      PROMPT="PLLinux";
      PROMPT2="";
    else
      PROMPT="PLLinux\set users\\$1";
      PROMPT2=" for $1";
    fi
    PROMPT="$PROMPT\\background tasks scheduler"
    abc=$(echo dialog --stdout --backtitle \"$PROMPT\" --cancel-label "Back" \
           --default-item $listnr3 \
       --menu \"Commands run$PROMPT2 in the background in the specified time. Managed by crond service.\" 0 0 8 \
       $(tasks_list) )
    cmd=$(eval $abc)
    if [ $? == 0 ]; then
      tasks_list_num $1
      listnr3=$cmd
      case $cmd in
      $listnr)
        PROMPT="$PROMPT\\new task"
        SMINUTE="*"
        SHOUR="*"
        SDAY="*"
        SMONTH="*"
        SDOW="*"
        SUSER="root"
        SCMD=""
        TASKSTEPNR=1
        while true; do
          case $TASKSTEPNR in
          0) break ;;
          1) task_schedule ;;
          2) task_command ;;
          3) if [ "$1" = "crontab" ]; then
               task_user
             else
               TASKSTEPNR=4
             fi ;;
          4) echo "$SMINUTE $SHOUR $SDAY $SMONTH $SDOW $SCMD" >> ${DIR}etc/crond.d/$SUSER
             chown $SUSER ${DIR}etc/crond.d/$SUSER
             chgrp $SUSER ${DIR}etc/crond.d/$SUSER
             dinitctl restart crond
             listnr=1
             for task_fn in $TASK_FILE_LIST; do
               while read -r line; do
                 if [ "$task_fn" = "crond.d/$SUSER" ] && [ "$line" = "$SMINUTE $SHOUR $SDAY $SMONTH $SDOW $SCMD" ]; then
                   listnr3=$listnr
                 fi
                 listnr=$(($listnr+1))
               done < "${DIR}etc/$task_fn"
             done
             break
          esac
        done
        ;;
      $(($listnr+1)) ) # delete
        task_delete ;;
      $(($listnr+2)) ) # cron log
         FNAME=""
         if [ -f "/log/cron" ]; then FNAME="/log/cron"; fi
         if [ -f "/log/tmp/cron" ]; then FNAME="/log/tmp/cron"; fi
         if [ "$FNAME" != "" ]; then
           clear
           cat $FNAME | grep $1 | less
         fi
        ;;
      *)
        PROMPT="$PROMPT\\edit task"
        listnr=1
        for task_fn in $TASK_FILE_LIST; do
          while read -r line; do
              IFS=" " read -r TASK_MIN TASK_HOUR TASK_DOM TASK_MONTH TASK_DOW TASK_COMMAND << EOF
$line
EOF
              TASK_USR="${task_fn#*/}"
            if [ "$listnr" = "$cmd" ]; then
              SMINUTE="$TASK_MIN"
              SHOUR="$TASK_HOUR"
              SDAY="$TASK_DOM"
              SMONTH="$TASK_MONTH"
              SDOW="$TASK_DOW"
              SUSER="$TASK_USR"
              SCMD="$TASK_COMMAND"
            fi
            listnr=$(($listnr+1))
          done < "${DIR}etc/$task_fn"
done
          TASKSTEPNR=1
          while true; do
            case $TASKSTEPNR in
            0) break ;;
            1) task_schedule ;;
            2) task_command ;;
            3) if [ "$1" != "crontab" ]; then
                 TASKSTEPNR=4
               else
                 task_user
               fi ;;
            4) listnr2=1
               for task_fn in $TASK_FILE_LIST; do
                 file_content=$(cat ${DIR}etc/$task_fn)
                 echo -n "" > ${DIR}etc/$task_fn
                 chown $SUSER ${DIR}etc/$task_fn
                 chgrp $SUSER ${DIR}etc/$task_fn
                 while IFS= read -r line; do
                   if [ "$listnr2" != "$listnr3" ]; then
                     echo "$line" >> ${DIR}etc/$task_fn
                   else
                       echo "$SMINUTE $SHOUR $SDAY $SMONTH $SDOW $SCMD" >> ${DIR}etc/$task_fn
                   fi
                   listnr2=$(($listnr2+1))
                 done <<< "$file_content"
               done
               dinitctl restart crond
               break
            esac
          done
          ;;
      esac
    else
      break;
    fi
  done
}


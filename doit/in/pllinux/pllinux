log_entry() {
  INPUT1="$1"
  INPUT2="$2"
  while true; do
    abc=$(echo dialog --stdout --backtitle \"$PROMPT\" --cancel-label "Back" \
           --default-item $listnr3 \
       --menu \"Logs saved to files \(temporary or permanent\)\" 0 0 8 \
       $(log_entry_list $INPUT1 $INPUT2) )
    cmd=$(eval $abc)
    if [ $? == 0 ]; then
      listnr=3
      IFS=";"
    for entry in $INPUT1; do
      listnr=$(($listnr+1))
    done
      IFS=$IFSORIG
      case $cmd in
      1 )  # search
        clear
        cat $INPUT2 | less # it seems, that msgbox and other dialog elements have size limit
        ;;
      2 )  #save and back
        LOG_RULES="$INPUT1"
        LOG_FILE="$INPUT2"
        break
        ;;
      $listnr) # file
        LOG_FILE="$INPUT2"
        log_file $1 $2
        INPUT2="$LOG_FILE" ;;
      $(($listnr+1)) )  #add rule
        LOG_TYPE=""
        LOG_PRIORITY=""
        TASKSTEPNR=1
        while true; do
          case $TASKSTEPNR in
          0) break; ;;
          1) log_feature_type ;;
          2) log_feature_priority ;;
          3) INPUT1="$INPUT1;${LOG_TYPE}.${LOG_PRIORITY}"
             break ;;
          esac
        done
        ;;
      $(($listnr+2)) )  #delete rule
        log_entry_rule_delete $INPUT1 $INPUT2
        INPUT1="$LOG_RULES"
        ;;
      $(($listnr+3)) )  #clear file
        ;;
      $(($listnr+4)) )  #delete all
        LOG_RULES=""
        LOG_FILE=""
        break;
        ;;
      *) # edit rule
        listnr3=3
        IFS=";"
        for entry in $INPUT1; do
          if [ "$cmd" = "$listnr3" ]; then
             break;
          fi
          listnr3=$(($listnr3+1))
        done
        IFS=$IFSORIG
        IFS="." read -r LOG_TYPE LOG_PRIORITY << EOF
$entry
EOF
        TASKSTEPNR=1
        while true; do
          case $TASKSTEPNR in
          0) break; ;;
          1) log_feature_type ;;
          2) log_feature_priority ;;
          3) NEWFEAT=""
             listnr=3
             IFS=";"
             for entry in $INPUT1; do
               if [ $NEWFEAT != "" ]; then $NEWFEAT="$NEWFEAT;"; fi
               if [ "$listnr3" = "$listnr" ]; then
                  NEWFEAT="$NEWFEAT${LOG_TYPE}.${LOG_PRIORITY}"
               else
                  NEWFEAT="$NEWFEAT$entry"
               fi
               listnr=$(($listnr+1))
             done
             INPUT1="${NEWFEAT}"
             IFS=$IFSORIG
             break ;;
          esac
        done
        ;;
      esac
    else
      LOG_RULES="$1"
      LOG_FILE="$2"
      break;
    fi
  done
}


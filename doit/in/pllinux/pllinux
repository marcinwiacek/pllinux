#!/app/busybox/current/bin/sh
# Part of PLLINUX. Version from 2 Aug 2026. Creating system cfg from cfg file or asking user and creating cfg file.

# some default values
TIMEZONE="UTC"
KEYB="qwerty/pl4.map.gz"
FONT="sun12x22.psfu.gz"
LANG="en_US.UTF-8"
OPT="def"

CFGFILE="/etc/pllinux.cfg"
if [ "$1" != "" ]; then
  CFGFILE="$1"
fi
if [ -e "$CFGFILE" ]; then
  while read -r line; do
    IFS="=" read -r PARAM_NAME PARAM_VALUE << EOF
$line
EOF
    case $PARAM_NAME in
    *KEYB* )
      /app/kbd/current/bin/loadkeys /app/kbd/current/share/keymaps/i386/$PARAM_VALUE
      KEYB=$PARAM_VALUE
      OPT=""
      ;;
    *FONT* )
      /app/kbd/current/bin/setfont -C /dev/tty1 $PARAM_VALUE 2> /dev/null
      /app/kbd/current/bin/setfont -C /dev/tty2 $PARAM_VALUE 2> /dev/null
      /app/kbd/current/bin/setfont -C /dev/tty3 $PARAM_VALUE 2> /dev/null
      /app/kbd/current/bin/setfont -C /dev/tty4 $PARAM_VALUE 2> /dev/null
      FONT=$PARAM_VALUE
      OPT=""
      ;;
    *TIMEZONE* )
      CURRENT=$(realpath /etc/localtime)
#      echo $CURRENT
      # save SSD writes
      case $CURRENT in
        *$PARAM_VALUE* )
#          echo Skipping setting timezone
          ;;
        * )
          echo Setting timezone $PARAM_VALUE
          rm /etc/localtime
          ln -s /app/tzdb/current/usr/share/zoneinfo/$PARAM_VALUE /etc/localtime
      esac
      TIMEZONE=$PARAM_VALUE
      ;;
    *LANG* )
      export LANG=$PARAM_VALUE
      LANG=$PARAM_VALUE
      ;;
    esac
  done < $CFGFILE
fi
if [ "$1" != "" ]; then
  exit
fi

set_keyboard_font() {
  KEYB2=$KEYB
  FONT2=$FONT
  while true; do
    if [ "$OPT" = "def" ]; then
      echo "  What national characters do you want to see or write? (pls provide two characters ISO code like us, pl, etc.)"
      read lang
      if [ ${#lang} != 2 ]; then
        echo "  Unknown country code. Ignoring."
      else
        KEYB2="qwerty/pl4.map.gz"
        FONT2="sun12x22.psfu.gz"
        if [ $lang = "pl" ]; then
          KEYB2="qwerty/pl1.map.gz"
          FONT2="LatGrkCyr-8x16.psfu.gz"
        fi
      fi
    fi
    echo "  Selected keyboard $KEYB2, screen font $FONT2"
    /app/kbd/current/bin/setfont -C /dev/tty1 $FONT2
    /app/kbd/current/bin/loadkeys /app/kbd/current/share/keymaps/i386/$KEYB2
    echo "  Write some text to check or \"back\" (no saving & back to main menu) or \"keyb\" (set keyboard) or \"font\" (set font) or \"save\" (save & back to main menu) or \"def\" (set default)"
    read OPT
    case $OPT in
      keyb)
        ls /app/kbd/current/share/keymaps/i386/qwerty
        ls /app/kbd/current/share/keymaps/i386/azerty
        ls /app/kbd/current/share/keymaps/i386/qwertz
        echo "  Please give keyboard name"
        read x
        if [ "$x" = "" ]; then
          echo "  Value cannot be empty. Ignoring"
        elif [ -e "/app/kbd/current/share/keymaps/i386/qwerty/$x" ]; then
          KEYB2="qwerty/$x"
        elif [ -e "/app/kbd/current/share/keymaps/i386/azerty/$x" ]; then
          KEYB2="azerty/$x"
        elif [ -e "/app/kbd/current/share/keymaps/i386/qwertz/$x" ]; then
          KEYB2="qwertz/$x"
        else
          echo "  Keyboard file \"$x\" not found. Ignoring."
        fi
        ;;
      font)
        ls /app/kbd/current/share/consolefonts
        echo "  Please give font name"
        read x
        if [ "$x" = "" ]; then
          echo "  Value cannot be empty. Ignoring"
        elif [ -e "/app/kbd/current/share/consolefonts/$x" ]; then
          FONT2="$x"
        else
          echo "  Screen font file \"$x\" not found. Ignoring."
        fi
        ;;
      back)
        KEYB2=$KEYB
        FONT2=$FONT
        break;
        ;;
      save)
        break;
        ;;
    esac
  done
  KEYB=$KEYB2
  FONT=$FONT2
  /app/kbd/current/bin/setfont -C /dev/tty1 $FONT
  /app/kbd/current/bin/loadkeys /app/kbd/current/share/keymaps/i386/$KEYB
}

set_time_zone() {
  TIMEZONE2=$TIMEZONE
  while true; do
    echo "  Selected timezone $TIMEZONE2";
    ls /app/tzdb/current/usr/share/zoneinfo
    echo "  Please enter region or timezone name or \"back\" (no saving) or \"save\" (save & go further)"
    read tz
    case $tz in
      back)
        TIMEZONE2=$TIMEZONE
        break
        ;;
      save)
        break;
        ;;
      *)
        if [ "$tz" = "" ]; then
          echo "  Value cannot be empty. Ignoring"
        elif [ -d "/app/tzdb/current/usr/share/zoneinfo/$tz" ]; then
          ls /app/tzdb/current/usr/share/zoneinfo/$tz
          echo "  Please enter timezone name or \"back\" (no saving & back to main menu) or \"save\" (save & back to main menu)"
          read tz2
          case $tz2 in
            back)
              TIMEZONE2=$TIMEZONE
              break;
              ;;
            save)
              break;
              ;;
            *)
              if [ "$tz2" = "" ]; then
                echo "  Value cannot be empty. Ignoring"
              elif [ -e "/app/tzdb/current/usr/share/zoneinfo/$tz/$tz2" ]; then
                TIMEZONE2=$tz/$tz2
              else
                echo "  Timezone file \"$tz/$tz2\" not found. Ignoring"
              fi
              ;;
          esac
        elif [ -e "/app/tzdb/current/usr/share/zoneinfo/$tz" ]; then
          TIMEZONE2=$tz
        else
          echo "  Timezone file \"$tz\" not found. Ignoring"
        fi
        ;;
    esac
  done
  TIMEZONE=$TIMEZONE2
}

while true; do
  echo "Selected keyboard $KEYB, screen font $FONT, timezone $TIMEZONE, app language $LANG"
  echo "Enter \"save\" (save to disk & quit) or \"quit\" (quit without changes) or \"input\" (set keyboard and font) or \"zone\" (set timezone)"
  read cmd
  case $cmd in
    *input* )
      set_keyboard_font
      ;;
    *zone* )
      set_time_zone
      ;;
    *quit* )
      return
      ;;
    *save* )
      break;
      ;;
    *)
      echo "Unknown option. Ignoring"
      ;;
  esac
done

#FIXME: dont save, when file is not updated. Save SSD
echo "# Created by script pllinux version from 2 Aug 2026" > /etc/pllinux.cfg
echo "KEYB=$KEYB" >> /etc/pllinux.cfg
echo "FONT=$FONT" >> /etc/pllinux.cfg
echo "TIMEZONE=$TIMEZONE" >> /etc/pllinux.cfg

#localedef -i pl_PL -c -f UTF-8 pl_PL.UTF-8
localedef -i en_US -c -f UTF-8 en_US.UTF-8
echo "LANG=en_US.UTF-8" >> /etc/pllinux.cfg

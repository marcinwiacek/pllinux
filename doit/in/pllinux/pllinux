    if [ $? == 0 ]; then
      if [ "$cmd" = "" ]; then
        dialog --backtitle "$PROMPT\\task command" \
          --msgbox "At least one option must be selected. Try again" 10 30
        continue
      fi
      listnr=1
      IFS=" "
      for task_fn in $TASK_FILE_LIST; do
        file_content=$(cat ${DIR}etc/$task_fn)
        echo -n "" > ${DIR}etc/$task_fn

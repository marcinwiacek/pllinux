#!/app/busybox/current/bin/sh

DIR="/" # path with / in the end. In real system /
if [ -d "/mnt/x" ]; then
  DIR="/mnt/x/"
fi

IFSORIG=$IFS

PARAMS1=""
PARAMS2=""

APP_LIST=$(${DIR}app/busybox/current/bin/ls ${DIR}app)
for APP_NAME in $APP_LIST; do
  if [ -e "${DIR}app/${APP_NAME}/current/readme.md" ]; then
    sectionInclude=0
    while read -r line; do
      if [ "$line" = "**Include**" ]; then
        sectionInclude=1
      elif [ "$line" = "" ]; then
        sectionInclude=0;
      elif [ "$sectionInclude" = 1 ]; then
        IFS=":"
        for folder in $line; do
          if [ -d "${DIR}app/${APP_NAME}/current/$folder" ]; then
            PARAMS1="-I /app/${APP_NAME}/current/$folder $PARAMS1"
          fi
        done
      fi
    done < ${DIR}app/${APP_NAME}/current/readme.md
  fi
  if [ -d "${DIR}app/${APP_NAME}/current/lib" ]; then
            PARAMS2="/app/${APP_NAME}/current/lib:$PARAMS2"
  fi
done

#echo "include $PARAMS1"
#echo "library $PARAMS2"

#echo "-B/app/gcc/current $PARAMS1 $@"

COMPILER_PATH="/app/gcc/current" && LIBRARY_PATH="$PARAMS2" && LD_LIBRARY_PATH="$PARAMS2" && gcc $PARAMS1 $@


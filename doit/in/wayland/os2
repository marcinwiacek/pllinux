#!/bin/bash
#rm -r /tmp/.X11-unix #this folder can be created by normal x11 and it's not sticky then
#XDG_RUNTIME_DIR=/run /app/xwayland/current/bin/Xwayland

LOGFILE=/tmp/$USER.wayland.1
if [ -d /log/tmp ]; then
  LOGFILE=/log/tmp/wayland
fi

XDG_RUNTIME_DIR=/run /app/xwayland/current/bin/Xwayland 2> /dev/null
/app/seatd/current/bin/seatd 2> /dev/null &
XDG_RUNTIME_DIR=/run strace /app/weston/current/bin/weston -c /etc/wayland/weston/weston.ini --xwayland 2> /tmp/$USER.wayland.2 > $LOGFILE
killall seatd
rm -r /tmp/.X11-unix
